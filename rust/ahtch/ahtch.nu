# replace NaN/inf (--nan/--posinf/--neginf)
# usage: ahtch nan_to_num <t1> [--nan <Float>] [--posinf <Float>] [--neginf <Float>]
export def "ahtch nan_to_num" [...rest: any, --nan: number, --posinf: number, --neginf: number]: any -> string {
  mut args = []
  if $nan != null { $args = ($args | append ["--nan" ($nan | into string)]) }
  if $posinf != null { $args = ($args | append ["--posinf" ($posinf | into string)]) }
  if $neginf != null { $args = ($args | append ["--neginf" ($neginf | into string)]) }
  let __rest = ($rest | each {|a| if ($a | describe | str starts-with "list") { $a | to json -r } else { $a | into string } })
  let __in = $in
  let __out = if $__in == null { ^ahtch nan_to_num ...$__rest ...$args } else { $__in | ^ahtch nan_to_num ...$__rest ...$args }
  $__out | str trim
}

export alias "nutorch nan_to_num" = torch nan_to_num

