# usage: ahtch log <t1>
export def "ahtch log" [...rest: any]: any -> string {
  let __rest = ($rest | each {|a| if ($a | describe | str starts-with "list") { $a | to json -r } else { $a | into string } })
  let __in = $in
  let __out = if $__in == null { ^ahtch log ...$__rest } else { $__in | ^ahtch log ...$__rest }
  $__out | str trim
}

export alias "nutorch log" = torch log

