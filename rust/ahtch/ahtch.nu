# usage: ahtch msort <t1>
export def "ahtch msort" [...rest: any]: any -> string {
  let __rest = ($rest | each {|a| if ($a | describe | str starts-with "list") { $a | to json -r } else { $a | into string } })
  let __in = $in
  let __out = if $__in == null { ^ahtch msort ...$__rest } else { $__in | ^ahtch msort ...$__rest }
  $__out | str trim
}

export alias "nutorch msort" = torch msort

# forward differences along --dim (default last)
# usage: ahtch diff <t1> [--dim <Int>]
export def "ahtch diff" [...rest: any, --dim: int]: any -> string {
  mut args = []
  if $dim != null { $args = ($args | append ["--dim" ($dim | into string)]) }
  let __rest = ($rest | each {|a| if ($a | describe | str starts-with "list") { $a | to json -r } else { $a | into string } })
  let __in = $in
  let __out = if $__in == null { ^ahtch diff ...$__rest ...$args } else { $__in | ^ahtch diff ...$__rest ...$args }
  $__out | str trim
}

export alias "nutorch diff" = torch diff

# non-inplace scatter: input, int64 index, src along --dim
# usage: ahtch scatter <t1> <t2> <t3> [--dim <Int>]
export def "ahtch scatter" [...rest: any, --dim: int]: any -> string {
  mut args = []
  if $dim != null { $args = ($args | append ["--dim" ($dim | into string)]) }
  let __rest = ($rest | each {|a| if ($a | describe | str starts-with "list") { $a | to json -r } else { $a | into string } })
  let __in = $in
  let __out = if $__in == null { ^ahtch scatter ...$__rest ...$args } else { $__in | ^ahtch scatter ...$__rest ...$args }
  $__out | str trim
}

export alias "nutorch scatter" = torch scatter

