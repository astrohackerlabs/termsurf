  let __rest = ($rest | each {|a| if ($a | describe | str starts-with "list") { $a | to json -r } else { $a | into string } })
  let __in = $in
  let __out = if $__in == null { ^ahtch kl_div ...$__rest ...$args } else { $__in | ^ahtch kl_div ...$__rest ...$args }
  $__out | str trim
}

export alias "nutorch kl_div" = torch kl_div

# seed the random number generator
export def "ahtch manual_seed" [seed: int]: nothing -> nothing {
  ^ahtch manual_seed ($seed | into string) | ignore
}

export alias "nutorch manual_seed" = torch manual_seed
