+/// Issue 26080510416061 Exp 1: product path must unbind Ctrl+L ClearScreen.
+#[cfg(test)]
+mod product_keybinding_tests {
+    use super::{build_product_keybindings, KeybindingsMode};
+    use crate::reedline_config::create_keybindings;
+    use crossterm::event::{KeyCode, KeyModifiers};
+    use nu_protocol::{Config, config::EditBindings};
+    use reedline::ReedlineEvent;
+
+    fn assert_ctrl_l_unbound(kb: &reedline::Keybindings, label: &str) {
+        match kb.find_binding(KeyModifiers::CONTROL, KeyCode::Char('l')) {
+            None => {}
+            Some(ReedlineEvent::ClearScreen) => {
+                panic!("{label}: Ctrl+L still bound to ClearScreen")
+            }
+            Some(other) => panic!("{label}: Ctrl+L unexpectedly bound to {other:?}"),
+        }
+    }
+
+    fn assert_baseline_has_clear_screen(kb: &reedline::Keybindings, label: &str) {
+        match kb.find_binding(KeyModifiers::CONTROL, KeyCode::Char('l')) {
+            Some(ReedlineEvent::ClearScreen) => {}
+            other => panic!("{label}: expected baseline ClearScreen, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn product_emacs_unbinds_ctrl_l_clear_screen() {
+        let config = Config::default();
+        assert_eq!(config.edit_mode, EditBindings::Emacs);
+
+        // Baseline (Nu/reedline defaults without product strip) still clears.
+        match create_keybindings(&config).expect("baseline keybindings") {
+            KeybindingsMode::Emacs(kb) => {
+                assert_baseline_has_clear_screen(&kb, "emacs baseline");
+            }
+            _other => panic!("expected emacs baseline, got non-emacs mode"),
+        }
+
+        // Product path (same helper setup_keybindings uses) removes ClearScreen.
+        match build_product_keybindings(&config).expect("product keybindings") {
+            KeybindingsMode::Emacs(kb) => {
+                assert_ctrl_l_unbound(&kb, "emacs product");
+                // Shannon switch still present
+                assert!(
+                    matches!(
+                        kb.find_binding(KeyModifiers::SHIFT, KeyCode::BackTab),
+                        Some(ReedlineEvent::ExecuteHostCommand(_))
+                    ),
+                    "Shift+BackTab product bind missing"
+                );
+            }
+            _other => panic!("expected emacs product maps, got non-emacs"),
+        }
+    }
+
+    #[test]
+    fn product_vi_unbinds_ctrl_l_clear_screen() {
+        let mut config = Config::default();
+        config.edit_mode = EditBindings::Vi;
+
+        match create_keybindings(&config).expect("baseline keybindings") {
+            KeybindingsMode::Vi {
+                insert_keybindings,
+                normal_keybindings,
+            } => {
+                assert_baseline_has_clear_screen(&insert_keybindings, "vi insert baseline");
+                assert_baseline_has_clear_screen(&normal_keybindings, "vi normal baseline");
+            }
+            _other => panic!("expected vi baseline"),
+        }
+
+        match build_product_keybindings(&config).expect("product keybindings") {
+            KeybindingsMode::Vi {
+                insert_keybindings,
+                normal_keybindings,
+            } => {
+                assert_ctrl_l_unbound(&insert_keybindings, "vi insert product");
+                assert_ctrl_l_unbound(&normal_keybindings, "vi normal product");
+            }
+            _other => panic!("expected vi product maps"),
+        }
+    }
+}
