+/// Product Astrohacker Shell keybinding overrides applied after Nu/reedline maps.
+///
+/// - Shift+BackTab → Shannon mode switch (existing product)
+/// - Unbind Ctrl+L ClearScreen so host `goto_split` right can own the chord when
+///   the key reaches the shell (rightmost pane pass-through). Issue 26080510416061.
+fn apply_astrohacker_product_keybinding_overrides(keybindings: &mut reedline::Keybindings) {
+    use crossterm::event::{KeyCode, KeyModifiers};
+    use reedline::ReedlineEvent;
+
+    keybindings.add_binding(
+        KeyModifiers::SHIFT,
+        KeyCode::BackTab,
+        ReedlineEvent::ExecuteHostCommand("__shannon_switch".into()),
+    );
+    // Reedline default maps Ctrl+L → ClearScreen in add_common_control_bindings.
+    let _ = keybindings.remove_binding(KeyModifiers::CONTROL, KeyCode::Char('l'));
+}
+
+/// Build product key maps: Nu `create_keybindings` then Astrohacker overrides.
+///
+/// This is the same path `setup_keybindings` uses for the REPL. Exposed for
+/// unit tests that must drive the real product setup (not a parallel table).
+pub(crate) fn build_product_keybindings(config: &Config) -> Result<KeybindingsMode, ShellError> {
+    match create_keybindings(config)? {
+        KeybindingsMode::Emacs(mut keybindings) => {
+            apply_astrohacker_product_keybinding_overrides(&mut keybindings);
+            Ok(KeybindingsMode::Emacs(keybindings))
+        }
+        KeybindingsMode::Vi {
+            mut insert_keybindings,
+            mut normal_keybindings,
+        } => {
+            apply_astrohacker_product_keybinding_overrides(&mut insert_keybindings);
+            apply_astrohacker_product_keybinding_overrides(&mut normal_keybindings);
+            Ok(KeybindingsMode::Vi {
+                insert_keybindings,
+                normal_keybindings,
+            })
+        }
+    }
+}
