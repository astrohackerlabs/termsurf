+//! Product highlighter wrapper: full-line `#` is AI input, not a comment.
+//!
+//! Issue 26082310413946 Exp 3. Inner highlighter (Nu / bash / NoOp) is
+//! unchanged for non-AI lines.
+
+use nu_ansi_term::Style;
+use reedline::{Highlighter, StyledText};
+
+use crate::is_shannon_ai_line;
+
+/// Wraps a dialect highlighter and paints AI lines as default foreground.
+pub struct ShannonHighlighter {
+    inner: Box<dyn Highlighter>,
+}
+
+impl ShannonHighlighter {
+    pub fn wrap(inner: Box<dyn Highlighter>) -> Self {
+        Self { inner }
+    }
+}
+
+impl Highlighter for ShannonHighlighter {
+    fn highlight(&self, line: &str, cursor: usize) -> StyledText {
+        if is_shannon_ai_line(line) {
+            let mut styled = StyledText::new();
+            styled.push((Style::new(), line.to_string()));
+            return styled;
+        }
+        self.inner.highlight(line, cursor)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use nu_ansi_term::Color;
+
+    struct PaintAll {
+        style: Style,
+    }
+
+    impl Highlighter for PaintAll {
+        fn highlight(&self, line: &str, _cursor: usize) -> StyledText {
+            let mut styled = StyledText::new();
+            styled.push((self.style, line.to_string()));
+            styled
+        }
+    }
+
+    fn wrap_red() -> ShannonHighlighter {
+        ShannonHighlighter::wrap(Box::new(PaintAll {
+            style: Style::new().fg(Color::Red),
+        }))
+    }
+
+    #[test]
+    fn ai_line_uses_default_style() {
+        let h = wrap_red();
+        for line in ["# hello", "  # hello", "## foo"] {
+            let styled = h.highlight(line, 0);
+            assert_eq!(styled.buffer.len(), 1, "{line:?}");
+            assert_eq!(styled.buffer[0].1, line);
+            assert_eq!(
+                styled.buffer[0].0,
+                Style::new(),
+                "AI line must not keep inner color: {line:?}"
+            );
+        }
+    }
+
+    #[test]
+    fn non_ai_line_delegates_to_inner() {
+        let h = wrap_red();
+        let styled = h.highlight("echo hi # note", 0);
+        assert_eq!(styled.buffer.len(), 1);
+        assert_eq!(styled.buffer[0].0, Style::new().fg(Color::Red));
+        assert_eq!(styled.buffer[0].1, "echo hi # note");
+    }
+}
