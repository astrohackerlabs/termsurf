+                Box::new(AlternateModeHighlighter)
             } else {
                 Box::new(NuHighlighter::new(
                     engine_reference.clone(),
@@ -1449,6 +1449,17 @@ fn flush_engine_state_repl_buffer(
     line_editor
 }
 
+/// Render AI prose literally, without parsing it as Nushell syntax.
+struct AlternateModeHighlighter;
+
+impl reedline::Highlighter for AlternateModeHighlighter {
+    fn highlight(&self, line: &str, _cursor: usize) -> reedline::StyledText {
+        let mut text = reedline::StyledText::new();
+        text.push((nu_ansi_term::Style::new(), line.to_owned()));
+        text
+    }
+}
+
 struct AlternateModeValidator;
 
 impl reedline::Validator for AlternateModeValidator {
@@ -2195,6 +2206,15 @@ mod product_keybinding_tests {
         }
     }
 
+    #[test]
+    fn ai_input_is_rendered_literally() {
+        use reedline::Highlighter;
+        for input in ["", "please explain {", "hello 🌍", "first\nsecond"] {
+            let rendered = super::AlternateModeHighlighter.highlight(input, input.len());
+            assert_eq!(rendered.render_simple(), input);
+        }
+    }
+
     #[test]
     fn ai_input_does_not_require_balanced_nushell_syntax() {
