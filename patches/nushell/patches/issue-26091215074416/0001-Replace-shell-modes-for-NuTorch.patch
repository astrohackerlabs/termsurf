-/// Magenta SGR for live `[ai]` overlay (not Nu green / zsh cyan).
-pub const AI_MODE_SGR: &str = "\x1b[35m";
-const RESET_SGR: &str = "\x1b[0m";
-
-/// Rewrite an ahsh left prompt so `[nu]` / `[zsh]` becomes magenta `[ai]`.
-pub fn overlay_ai_mode_label(left: &str) -> String {
-    overlay_mode_tag(left, "[nu]")
-        .or_else(|| overlay_mode_tag(left, "[zsh]"))
-        .unwrap_or_else(|| left.to_string())
-}
-
-fn overlay_mode_tag(left: &str, tag: &str) -> Option<String> {
-    let idx = left.find(tag)?;
-    let mut start = idx;
-    let end_tag = idx + tag.len();
-    if let Some(csi) = preceding_sgr(left, idx) {
-        start = csi;
-    }
-    let mut end = end_tag;
-    if left[end..].starts_with(RESET_SGR) {
-        end += RESET_SGR.len();
-    }
-    let mut out = String::with_capacity(left.len() + 8);
-    out.push_str(&left[..start]);
-    out.push_str(AI_MODE_SGR);
-    out.push_str("[ai]");
-    out.push_str(RESET_SGR);
-    out.push_str(&left[end..]);
-    Some(out)
-}
