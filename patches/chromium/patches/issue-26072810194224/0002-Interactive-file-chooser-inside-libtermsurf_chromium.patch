   base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
   if (!command_line->HasSwitch(kTermSurfFileUploadAutoSelectSwitch)) {
-    LogChooserRequest("interactive-fallback", params);
     return false;
   }
 
@@ -135,7 +322,7 @@ bool MaybeRunTsFileChooser(RenderFrameHost* render_frame_host,
           selected_path, selected_path.BaseName().AsUTF16Unsafe(),
           std::vector<std::u16string>())));
 
-  LOG(INFO) << "[termsurf-file-upload] selected"
+  LOG(INFO) << "[termsurf-file-upload] auto-selected"
             << " path=" << selected_path.AsUTF8Unsafe()
             << " basename=" << selected_path.BaseName().AsUTF8Unsafe()
             << " size=" << selected_size << " frame=" << render_frame_host;
@@ -144,4 +331,30 @@ bool MaybeRunTsFileChooser(RenderFrameHost* render_frame_host,
   return true;
 }
 
+}  // namespace
+
+bool RunTsFileChooser(RenderFrameHost* render_frame_host,
+                      scoped_refptr<FileSelectListener> listener,
+                      const blink::mojom::FileChooserParams& params) {
+  // 1) Automation first.
+  if (TryAutoSelect(render_frame_host, listener, params)) {
+    return true;
+  }
+
+  // 2) Interactive open/upload (in-dylib SelectFileDialog).
+  const char* reason = nullptr;
+  if (IsOrdinaryReadOnlyUpload(params, &reason)) {
+    TsInteractiveFileSelectHelper::Run(render_frame_host, std::move(listener),
+                                       params);
+    return true;
+  }
+
+  // 3) Unsupported mode — cancel; do not fall through to base cancel-only path
+  // without logging.
+  LogChooserRequest("cancelled-unsupported", params);
+  LOG(WARNING) << "[termsurf-file-upload] cancelled reason=" << reason;
+  listener->FileSelectionCanceled();
+  return true;
+}
+
 }  // namespace content
