+// Handles file chooser requests for TermSurf Chromium.
+//
+// 1) If --termsurf-file-upload-auto-select=/abs/path is set, selects that file
+//    (automation / Issue 799).
+// 2) Otherwise, for ordinary open/upload modes, shows ui::SelectFileDialog
+//    (NSOpenPanel on macOS). Implementation lives in this dylib (Exp 2 —
+//    do not call unlinked ShellFileSelectHelper).
+// 3) Other modes cancel cleanly.
+//
+// Always completes |listener|; returns true so the platform delegate must not
+// fall through to cancel-only base ShellPlatformDelegate.
+bool RunTsFileChooser(RenderFrameHost* render_frame_host,
+                      scoped_refptr<FileSelectListener> listener,
+                      const blink::mojom::FileChooserParams& params);
+
+// Back-compat name used by older call sites / tests.
+inline bool MaybeRunTsFileChooser(
+    RenderFrameHost* render_frame_host,
+    scoped_refptr<FileSelectListener> listener,
+    const blink::mojom::FileChooserParams& params) {
+  return RunTsFileChooser(render_frame_host, std::move(listener), params);
+}
 
 }  // namespace content
 
