From 182ebbac7331d7bf84889f71f64c297cfdbf591b Mon Sep 17 00:00:00 2001
From: "Ryan X. Charles" <ryan@ryanxcharles.com>
Date: Thu, 30 Jul 2026 05:44:52 -0500
Subject: [PATCH] Always embed-hidden Content Shell on Mac
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Product Chromium never shows a windowed shell.
Unconditional transparent shell window; never
steal key focus from the TermSurf host. Drop
switches::kHidden — mode is the binary.
---
 .../browser/shell_platform_delegate_mac.mm    | 54 ++++++-------------
 content/shell/common/shell_switches.h         |  5 --
 2 files changed, 15 insertions(+), 44 deletions(-)

diff --git a/content/shell/browser/shell_platform_delegate_mac.mm b/content/shell/browser/shell_platform_delegate_mac.mm
index ae9670bf9d..4d7aae71bf 100644
--- a/content/shell/browser/shell_platform_delegate_mac.mm
+++ b/content/shell/browser/shell_platform_delegate_mac.mm
@@ -10,7 +10,6 @@
 
 #import "base/apple/foundation_util.h"
 #include "base/check_op.h"
-#include "base/command_line.h"
 #include "base/logging.h"
 #include "base/memory/raw_ptr.h"
 #include "base/notreached.h"
@@ -22,7 +21,6 @@
 #include "content/public/browser/web_contents.h"
 #include "content/shell/app/resource.h"
 #include "content/shell/browser/shell.h"
-#include "content/shell/common/shell_switches.h"
 #include "ui/gfx/native_ui_types.h"
 #include "url/gurl.h"
 
@@ -225,18 +223,14 @@ void MakeShellButton(NSRect* rect,
     shell_data.url_edit_view = url_edit_view;
   }
 
-  // Show the new window (unless --hidden).
-  if (base::CommandLine::ForCurrentProcess()->HasSwitch(switches::kHidden)) {
-    // Make the window fully transparent instead of ordering it out.
-    // orderOut: triggers NSWindowDidChangeOcclusionStateNotification which
-    // sets render_widget_host_is_hidden_ = true, detaching the compositor.
-    // setAlphaValue:0 keeps the window in the window list so the compositor
-    // stays active and CAContext survives navigation.
-    [window setAlphaValue:0.0];
-    [window orderWindow:NSWindowBelow relativeTo:0];
-  } else {
-    [window makeKeyAndOrderFront:nil];
-  }
+  // Product Chromium is always the TermSurf embed helper (never a normal
+  // windowed Content Shell). Make the window fully transparent instead of
+  // ordering it out: orderOut: triggers NSWindowDidChangeOcclusionStateNotification
+  // which sets render_widget_host_is_hidden_ = true, detaching the compositor.
+  // setAlphaValue:0 keeps the window in the window list so the compositor
+  // stays active and CAContext survives navigation.
+  [window setAlphaValue:0.0];
+  [window orderWindow:NSWindowBelow relativeTo:0];
 
   shell_data.delegate = delegate;
 }
@@ -345,33 +339,15 @@ void MakeShellButton(NSRect* rect,
   ShellData& shell_data = shell_data_map_[shell];
 
   // This focuses the main frame RenderWidgetHost in the window, but does not
-  // make the window itself active. The WebContentsDelegate (this class) is
-  // responsible for doing both.
-  const bool hidden =
-      base::CommandLine::ForCurrentProcess()->HasSwitch(switches::kHidden);
+  // make the window itself active. Product Chromium always stays embed-hidden
+  // and exports its layer to the TermSurf host. Activating the shell window
+  // would steal key-window status from the host after browser-driven focus
+  // events such as Back navigation.
   NSWindow* window = shell_data.delegate.window;
-  LogTermSurfActivationState("before_focus", window, hidden);
+  LogTermSurfActivationState("before_focus", window, /*embed_hidden=*/true);
   top_contents->Focus();
-  LogTermSurfActivationState("after_focus", window, hidden);
-
-  if (hidden) {
-    // Embedded TermSurf Roamium keeps the content shell window hidden and
-    // exports its layer to Ghostboard. Activating that hidden window steals
-    // key-window status from Ghostboard after browser-driven focus events such
-    // as Back navigation.
-    LogTermSurfActivationState("after_activate", window, hidden);
-    return;
-  }
-
-  LogTermSurfActivationState("before_activate", window, hidden);
-  // This makes the window the active window for the application, and when the
-  // app is active, the window will be also. That makes all RenderWidgetHosts
-  // for the window active (which is separate from focused on mac).
-  [window makeKeyAndOrderFront:nil];
-  // This makes the application active so that we can actually move focus
-  // between windows and the renderer can receive focus/blur events.
-  [NSApp activateIgnoringOtherApps:YES];
-  LogTermSurfActivationState("after_activate", window, hidden);
+  LogTermSurfActivationState("after_focus", window, /*embed_hidden=*/true);
+  LogTermSurfActivationState("after_activate", window, /*embed_hidden=*/true);
 }
 
 void ShellPlatformDelegate::DidNavigatePrimaryMainFramePostCommit(
diff --git a/content/shell/common/shell_switches.h b/content/shell/common/shell_switches.h
index 8f3fd4b3e0..8757fa418d 100644
--- a/content/shell/common/shell_switches.h
+++ b/content/shell/common/shell_switches.h
@@ -50,11 +50,6 @@ inline constexpr char kIsolatedContextOrigins[] = "isolated-context-origins";
 // risk.
 inline constexpr char kRemoteDebuggingAddress[] = "remote-debugging-address";
 
-// Hide the Content Shell window (make it transparent and order it behind
-// all other windows). Used by TermSurf browser binaries that render via
-// CALayerHost compositing instead of a native window.
-inline constexpr char kHidden[] = "hidden";
-
 // Runs Content Shell in web test mode, injecting test-only behaviour for
 // blink web tests.
 inline constexpr char kRunWebTests[] = "run-web-tests";
-- 
