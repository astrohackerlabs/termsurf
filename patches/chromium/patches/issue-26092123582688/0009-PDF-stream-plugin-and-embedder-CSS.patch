+void TsContentClient::AddPlugins(std::vector<content::WebPluginInfo>* plugins) {
+  ShellContentClient::AddPlugins(plugins);
+
+#if BUILDFLAG(ENABLE_PDF)
+  static constexpr char16_t kPDFPluginName[] = u"Chromium PDF Plugin";
+  static constexpr char16_t kPDFPluginDescription[] = u"Built-in PDF viewer";
+  static constexpr char kPDFPluginExtension[] = "pdf";
+  static constexpr char kPDFPluginExtensionDescription[] =
+      "Portable Document Format";
+
+  content::WebPluginInfo pdf_info;
+  pdf_info.name = kPDFPluginName;
+  pdf_info.path = base::FilePath(kTsPdfInternalPluginPath);
+  pdf_info.desc = kPDFPluginDescription;
+  content::WebPluginMimeType pdf_mime_type(pdf::kInternalPluginMimeType,
+                                           kPDFPluginExtension,
+                                           kPDFPluginExtensionDescription);
+  pdf_info.mime_types.push_back(pdf_mime_type);
+  content::WebPluginMimeType pdf_document_mime_type(
+      pdf::kPDFMimeType, kPDFPluginExtension, kPDFPluginExtensionDescription);
+  pdf_info.mime_types.push_back(pdf_document_mime_type);
+  pdf_info.type = content::WebPluginInfo::PLUGIN_TYPE_BROWSER_INTERNAL_PLUGIN;
+  plugins->push_back(pdf_info);
+
+  LOG(INFO) << "[issue-792-exp15] internal-pdf-plugin-registered mime_type="
+            << pdf::kInternalPluginMimeType
+            << " document_mime_type=" << pdf::kPDFMimeType
+            << " path=" << pdf_info.path.value();
+#endif
+}
