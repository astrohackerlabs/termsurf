+void TsBrowserMainParts::CapturePng(
+    void* wc_handle,
+    void (*cb)(void* wc,
+               int ok,
+               const uint8_t* png,
+               size_t png_len,
+               uint64_t width_px,
+               uint64_t height_px,
+               void* user_data),
+    void* user_data) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!cb) {
+    return;
+  }
+
+  TabState* tab = FindTab(wc_handle);
+  if (!tab || !tab->shell || !tab->shell->web_contents()) {
+    cb(wc_handle, 0, nullptr, 0, 0, 0, user_data);
+    return;
+  }
+
+  RenderWidgetHostView* view =
+      tab->shell->web_contents()->GetRenderWidgetHostView();
+  if (!view) {
+    cb(wc_handle, 0, nullptr, 0, 0, 0, user_data);
+    return;
+  }
+
+  struct CaptureState {
+    uintptr_t wc_handle;
+    void (*cb)(void* wc,
+               int ok,
+               const uint8_t* png,
+               size_t png_len,
+               uint64_t width_px,
+               uint64_t height_px,
+               void* user_data);
+    uintptr_t user_data;
+  };
+  CaptureState state{reinterpret_cast<uintptr_t>(wc_handle), cb,
+                     reinterpret_cast<uintptr_t>(user_data)};
+
+  view->CopyFromSurface(
+      gfx::Rect(), gfx::Size(), base::Seconds(4),
+      base::BindOnce(
+          [](CaptureState state, const CopyFromSurfaceResult& result) {
+            void* wc = reinterpret_cast<void*>(state.wc_handle);
+            void* user_data = reinterpret_cast<void*>(state.user_data);
+            if (!result.has_value()) {
+              state.cb(wc, 0, nullptr, 0, 0, 0, user_data);
+              return;
+            }
+            const SkBitmap& bitmap = result->bitmap;
+            if (bitmap.drawsNothing()) {
+              state.cb(wc, 0, nullptr, 0, 0, 0, user_data);
+              return;
+            }
+            std::optional<std::vector<uint8_t>> png =
+                gfx::PNGCodec::EncodeBGRASkBitmap(
+                    bitmap, /*discard_transparency=*/false);
+            if (!png || png->empty()) {
+              state.cb(wc, 0, nullptr, 0, 0, 0, user_data);
+              return;
+            }
+            state.cb(wc, 1, png->data(), png->size(),
+                     static_cast<uint64_t>(bitmap.width()),
+                     static_cast<uint64_t>(bitmap.height()), user_data);
+          },
+          state));
+}
+
 TsBrowserMainParts::TabState* TsBrowserMainParts::FindTab(void* wc_handle) {
   for (auto& t : tabs_) {
     if (t->shell && static_cast<void*>(t->shell->web_contents()) == wc_handle) {
