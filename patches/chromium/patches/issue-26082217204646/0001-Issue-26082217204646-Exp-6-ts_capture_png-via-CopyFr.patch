 .../libtermsurf_chromium.cc                   | 19 +++++
 .../libtermsurf_chromium.h                    | 14 ++++
 .../ts_browser_main_parts.cc                  | 77 +++++++++++++++++++
 .../ts_browser_main_parts.h                   | 11 +++
 5 files changed, 123 insertions(+)

