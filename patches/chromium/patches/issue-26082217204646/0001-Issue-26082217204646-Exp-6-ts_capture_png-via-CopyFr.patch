   return g_main_parts->NavigationAction(wc, action);
 }
 
+void ts_capture_png(ts_web_contents_t wc,
+                    void (*cb)(ts_web_contents_t wc,
+                               int ok,
+                               const uint8_t* png,
+                               size_t png_len,
+                               uint64_t width_px,
+                               uint64_t height_px,
+                               void* user_data),
+                    void* user_data) {
+  if (!cb) {
+    return;
+  }
+  if (!g_main_parts) {
+    cb(wc, 0, nullptr, 0, 0, 0, user_data);
+    return;
+  }
+  g_main_parts->CapturePng(wc, cb, user_data);
+}
