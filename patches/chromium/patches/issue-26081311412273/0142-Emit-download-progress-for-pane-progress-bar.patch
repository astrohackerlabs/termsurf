+void (*g_on_download_progress)(void* wc,
+                               const char* state,
+                               uint64_t received_bytes,
+                               uint64_t total_bytes,
+                               void* user_data) = nullptr;
+void* g_on_download_progress_data = nullptr;
+}
+
 namespace {
 
 // Global state for the library.
@@ -534,6 +545,16 @@ void ts_set_on_loading_state(void (*cb)(ts_web_contents_t wc,
   g_on_loading_state_data = user_data;
 }
 
+void ts_set_on_download_progress(void (*cb)(ts_web_contents_t wc,
