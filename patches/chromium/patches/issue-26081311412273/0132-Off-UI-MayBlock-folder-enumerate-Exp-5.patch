+
 bool IsRegularFileAbsolute(const base::FilePath& path,
                            int64_t* size,
                            const char** reason) {
@@ -123,7 +128,8 @@ bool IsRegularFileAbsolute(const base::FilePath& path,
   return true;
 }
 
-bool IsDirectoryAbsolute(const base::FilePath& path, const char** reason) {
+bool IsDirectoryAbsoluteBlocking(const base::FilePath& path,
+                                 const char** reason) {
   if (path.empty()) {
     *reason = "empty-path";
     return false;
@@ -164,15 +170,34 @@ int PathDepthUnderBase(const base::FilePath& base_dir,
   return depth;
 }
 
-// Enumerate regular files under |base_dir|. Skips symlinks. Caps count/depth.
-// Display names are paths relative to |base_dir| (for webkitRelativePath).
-bool EnumerateUploadFolder(
-    const base::FilePath& base_dir,
-    std::vector<blink::mojom::FileChooserFileInfoPtr>* out_files,
-    const char** reason) {
-  out_files->clear();
-  if (!IsDirectoryAbsolute(base_dir, reason)) {
-    return false;
+// Result of a MayBlock folder walk. Movable only (holds mojom unique_ptrs).
+struct EnumerateUploadFolderResult {
+  bool ok = false;
+  std::string fail_reason;
+  base::FilePath base_dir;
+  std::vector<blink::mojom::FileChooserFileInfoPtr> files;
+
+  EnumerateUploadFolderResult() = default;
+  EnumerateUploadFolderResult(EnumerateUploadFolderResult&&) = default;
+  EnumerateUploadFolderResult& operator=(EnumerateUploadFolderResult&&) =
+      default;
+  EnumerateUploadFolderResult(const EnumerateUploadFolderResult&) = delete;
+  EnumerateUploadFolderResult& operator=(const EnumerateUploadFolderResult&) =
+      delete;
+};
+
+// MUST run only on a task that allows blocking (ThreadPool MayBlock).
+// Exp 4 Fail: calling this (or FileEnumerator) on CrBrowserMain aborts.
+EnumerateUploadFolderResult EnumerateUploadFolderOnBlockingThread(
+    base::FilePath base_dir) {
+  EnumerateUploadFolderResult result;
+  result.base_dir = base_dir;
+
+  const char* reason = nullptr;
+  if (!IsDirectoryAbsoluteBlocking(base_dir, &reason)) {
+    result.ok = false;
+    result.fail_reason = reason ? reason : "invalid-directory";
+    return result;
   }
 
   base::FileEnumerator enumerator(
@@ -186,14 +211,10 @@ bool EnumerateUploadFolder(
     if (lstat(path.value().c_str(), &stat_info) != 0) {
       continue;
     }
-    // Skip any symlink (file or directory).
     if (S_ISLNK(stat_info.st_mode)) {
       continue;
     }
     if (S_ISDIR(stat_info.st_mode)) {
-      // Do not emit directory entries; recursion is handled by enumerator.
-      // Depth bound: skip descending further by not following into deep trees
-      // — FileEnumerator has already entered; filter files by depth instead.
       continue;
     }
     if (!S_ISREG(stat_info.st_mode)) {
@@ -211,45 +232,64 @@ bool EnumerateUploadFolder(
     std::u16string display_name;
     if (base_dir.AppendRelativePath(path, &relative) && !relative.empty()) {
       display_name = relative.AsUTF16Unsafe();
-      // webkitRelativePath uses POSIX-style separators in the page.
       base::ReplaceChars(display_name, u"\\", u"/", &display_name);
     } else {
       display_name = path.BaseName().AsUTF16Unsafe();
     }
 
-    out_files->push_back(blink::mojom::FileChooserFileInfo::NewNativeFile(
+    result.files.push_back(blink::mojom::FileChooserFileInfo::NewNativeFile(
         blink::mojom::NativeFileInfo::New(path, display_name,
                                          std::vector<std::u16string>())));
 
-    if (out_files->size() >= kMaxUploadFolderFiles) {
+    if (result.files.size() >= kMaxUploadFolderFiles) {
       LOG(WARNING) << "[termsurf-file-upload] folder-enumerate hit max files="
-                   << kMaxUploadFolderFiles << " base="
-                   << base_dir.AsUTF8Unsafe();
+                   << kMaxUploadFolderFiles
+                   << " base=" << base_dir.AsUTF8Unsafe();
       break;
     }
   }
 
+  result.ok = true;
   LOG(INFO) << "[termsurf-file-upload] folder-enumerated count="
-            << out_files->size() << " base=" << base_dir.AsUTF8Unsafe();
-  return true;
+            << result.files.size() << " base=" << base_dir.AsUTF8Unsafe();
+  return result;
 }
 
-void CompleteWithUploadFolder(
-    scoped_refptr<FileSelectListener> listener,
-    const base::FilePath& base_dir) {
-  const char* reason = nullptr;
-  std::vector<blink::mojom::FileChooserFileInfoPtr> files;
-  if (!EnumerateUploadFolder(base_dir, &files, &reason)) {
+// UI thread: complete the parked listener after MayBlock walk returns.
+void FinishUploadFolderOnUI(scoped_refptr<FileSelectListener> listener,
+                            EnumerateUploadFolderResult result) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!listener) {
+    return;
+  }
+  if (!result.ok) {
     LOG(WARNING) << "[termsurf-file-upload] folder-enumerate failed reason="
-                 << reason << " base=" << base_dir.AsUTF8Unsafe();
+                 << result.fail_reason
+                 << " base=" << result.base_dir.AsUTF8Unsafe();
     listener->FileSelectionCanceled();
     return;
   }
   // Empty directory is a successful selection with zero files (Chrome-like).
-  listener->FileSelected(std::move(files), base_dir,
+  listener->FileSelected(std::move(result.files), result.base_dir,
                          blink::mojom::FileChooserParams::Mode::kUploadFolder);
 }
 
+// UI thread only: post MayBlock enumerate; never FileEnumerator here.
+// Exp 5: fixes Exp 4 AssertBlockingAllowed abort on CrBrowserMain.
+void StartCompleteWithUploadFolder(scoped_refptr<FileSelectListener> listener,
+                                   base::FilePath base_dir) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  LOG(INFO) << "[termsurf-file-upload] folder-enumerate-async-start base="
+            << base_dir.AsUTF8Unsafe();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&EnumerateUploadFolderOnBlockingThread,
+                     std::move(base_dir)),
+      base::BindOnce(&FinishUploadFolderOnUI, std::move(listener)));
+}
+
 struct PendingFileChooser {
   PendingFileChooser(uint64_t request_id,
                      scoped_refptr<FileSelectListener> listener,
@@ -304,8 +344,9 @@ bool TryAutoSelect(RenderFrameHost* render_frame_host,
       command_line->GetSwitchValuePath(kTermSurfFileUploadAutoSelectSwitch);
 
   if (params.mode == blink::mojom::FileChooserParams::Mode::kUploadFolder) {
-    if (!IsDirectoryAbsolute(selected_path, &reason)) {
-      LOG(WARNING) << "[termsurf-file-upload] cancelled reason=" << reason
+    // Non-blocking path checks only; full dir validate + walk on MayBlock.
+    if (selected_path.empty() || !selected_path.IsAbsolute()) {
+      LOG(WARNING) << "[termsurf-file-upload] cancelled reason=relative-path"
                    << " path=" << selected_path.AsUTF8Unsafe();
       listener->FileSelectionCanceled();
       return true;
@@ -313,7 +354,7 @@ bool TryAutoSelect(RenderFrameHost* render_frame_host,
     LOG(INFO) << "[termsurf-file-upload] auto-selected-folder path="
               << selected_path.AsUTF8Unsafe()
               << " frame=" << render_frame_host;
-    CompleteWithUploadFolder(std::move(listener), selected_path);
+    StartCompleteWithUploadFolder(std::move(listener), selected_path);
     return true;
   }
 
@@ -436,7 +477,7 @@ bool TsReplyFileChooser(WebContents* web_contents,
       UNSAFE_BUFFERS(base::span(paths, path_count));
 
   if (mode == blink::mojom::FileChooserParams::Mode::kUploadFolder) {
-    // Host returns a single directory path; engine enumerates.
+    // Host returns a single directory path; engine enumerates off UI (Exp 5).
     const char* first = nullptr;
     for (const char* path_cstr : path_span) {
       if (path_cstr && path_cstr[0] != '\0') {
@@ -449,9 +490,15 @@ bool TsReplyFileChooser(WebContents* web_contents,
       return true;
     }
     base::FilePath dir = base::FilePath::FromUTF8Unsafe(first);
+    if (!dir.IsAbsolute()) {
+      LOG(WARNING) << "[termsurf-file-upload] folder non-absolute path="
+                   << first;
+      listener->FileSelectionCanceled();
+      return true;
+    }
     LOG(INFO) << "[termsurf-file-upload] host-mediated folder request_id="
               << stored_request_id << " dir=" << dir.AsUTF8Unsafe();
-    CompleteWithUploadFolder(std::move(listener), dir);
+    StartCompleteWithUploadFolder(std::move(listener), std::move(dir));
     return true;
   }
 
