+bool TryHostMediatedChooser(RenderFrameHost* render_frame_host,
+                            scoped_refptr<FileSelectListener> listener,
+                            const blink::mojom::FileChooserParams& params) {
+  const char* reason = nullptr;
+  if (!IsOrdinaryReadOnlyUpload(params, &reason)) {
+    return false;
+  }
+
+  WebContents* web_contents =
+      WebContents::FromRenderFrameHost(render_frame_host);
+  if (!web_contents) {
+    LOG(WARNING) << "[termsurf-file-upload] host-mediated missing WebContents";
+    listener->FileSelectionCanceled();
+    return true;
+  }
+
+  auto& pending = PendingChoosers();
+  if (pending.contains(web_contents)) {
+    LOG(WARNING) << "[termsurf-file-upload] host-mediated already pending";
+    listener->FileSelectionCanceled();
+    return true;
+  }
+
+  const uint64_t request_id = NextRequestId()++;
+  pending.emplace(
+      web_contents,
+      PendingFileChooser(request_id, std::move(listener), params.mode));
+
+  std::string origin_url = OriginUrlFor(render_frame_host);
+  std::vector<std::string> accept_storage;
+  std::vector<const char*> accept_ptrs;
+  accept_storage.reserve(params.accept_types.size());
+  accept_ptrs.reserve(params.accept_types.size());
+  for (const auto& accept_type : params.accept_types) {
+    accept_storage.push_back(base::UTF16ToUTF8(accept_type));
+  }
+  for (const auto& s : accept_storage) {
+    accept_ptrs.push_back(s.c_str());
+  }
+
+  const char* mode = FileChooserModeWire(params.mode);
+  LogChooserRequest("host-mediated-request", params);
+  LOG(INFO) << "[termsurf-file-upload] host-mediated request_id=" << request_id
+            << " mode=" << mode << " origin=" << origin_url
+            << " accept_count=" << accept_ptrs.size();
+
+  TsNotifyFileChooserRequest(
+      static_cast<void*>(web_contents), request_id, mode, origin_url.c_str(),
+      accept_ptrs.empty() ? nullptr : accept_ptrs.data(), accept_ptrs.size());
+  return true;
+}
+
 }  // namespace
 
+bool TsReplyFileChooser(WebContents* web_contents,
+                        uint64_t request_id,
+                        bool accepted,
+                        const char* const* paths,
+                        size_t path_count) {
+  if (!web_contents) {
+    return false;
+  }
+
+  auto& pending = PendingChoosers();
+  auto it = pending.find(web_contents);
+  if (it == pending.end()) {
+    LOG(WARNING) << "[termsurf-file-upload] reply-missing wc=" << web_contents
+                 << " request_id=" << request_id;
+    return false;
+  }
+
+  if (request_id != 0 && it->second.request_id != request_id) {
+    LOG(WARNING) << "[termsurf-file-upload] reply-mismatch wc=" << web_contents
+                 << " expected=" << it->second.request_id
+                 << " got=" << request_id;
+    return false;
+  }
+
+  auto listener = std::move(it->second.listener);
+  auto mode = it->second.mode;
+  uint64_t stored_request_id = it->second.request_id;
+  pending.erase(it);
+
+  if (!accepted || !paths || path_count == 0) {
+    LOG(INFO) << "[termsurf-file-upload] host-mediated cancel request_id="
+              << stored_request_id;
+    listener->FileSelectionCanceled();
+    return true;
+  }
+
+  // paths is a C array of absolute path C strings from the host reply FFI.
+  base::span<const char* const> path_span =
+      // SAFETY: caller provides |path_count| entries for |paths|.
+      UNSAFE_BUFFERS(base::span(paths, path_count));
+
+  std::vector<blink::mojom::FileChooserFileInfoPtr> chooser_files;
+  chooser_files.reserve(path_count);
+  for (const char* path_cstr : path_span) {
+    if (!path_cstr || path_cstr[0] == '\0') {
+      continue;
+    }
+    base::FilePath path = base::FilePath::FromUTF8Unsafe(path_cstr);
+    if (!path.IsAbsolute()) {
+      LOG(WARNING) << "[termsurf-file-upload] skip non-absolute path="
+                   << path_cstr;
+      continue;
+    }
+    chooser_files.push_back(blink::mojom::FileChooserFileInfo::NewNativeFile(
+        blink::mojom::NativeFileInfo::New(
+            path, path.BaseName().AsUTF16Unsafe(),
+            std::vector<std::u16string>())));
+  }
+
+  if (chooser_files.empty()) {
+    LOG(INFO) << "[termsurf-file-upload] host-mediated empty paths request_id="
+              << stored_request_id;
+    listener->FileSelectionCanceled();
+    return true;
+  }
+
+  LOG(INFO) << "[termsurf-file-upload] host-mediated selected count="
+            << chooser_files.size() << " request_id=" << stored_request_id;
+  listener->FileSelected(std::move(chooser_files), base::FilePath(), mode);
+  return true;
+}
