diff --git a/content/libtermsurf_chromium/ts_download_progress.cc b/content/libtermsurf_chromium/ts_download_progress.cc
new file mode 100644
index 0000000000..3ab5f7800a
--- /dev/null
+++ b/content/libtermsurf_chromium/ts_download_progress.cc
@@ -0,0 +1,189 @@
+// Copyright 2026 TermSurf
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/libtermsurf_chromium/ts_download_progress.h"
+
+#include <stdint.h>
+
+#include <algorithm>
+
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "base/byte_count.h"
+#include "components/download/public/common/download_item.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/download_item_utils.h"
+#include "content/public/browser/download_manager.h"
+#include "content/public/browser/web_contents.h"
+#include "net/http/http_response_headers.h"
+
+namespace content {
+namespace {
+
+// Defined in libtermsurf_chromium.cc.
+extern "C" void (*g_on_download_progress)(void* wc,
+                                          const char* state,
+                                          uint64_t received_bytes,
+                                          uint64_t total_bytes,
+                                          void* user_data);
+extern "C" void* g_on_download_progress_data;
+
+// Resolve total size for pane progress (Issue 26073112048720 Exp 4).
+// Returns 0 when size is truly unknown → indeterminate bar.
+// Prefer DownloadItem totals; fall back to Content-Length when the item has not
+// populated total_bytes_ yet (common early in Content-Length attachments).
+uint64_t ResolveDownloadTotalBytes(download::DownloadItem* item,
+                                   uint64_t received) {
+  if (!item) {
+    return 0;
+  }
+
+  const int64_t item_total = item->GetTotalBytes();
+  if (item_total > 0) {
+    return static_cast<uint64_t>(item_total);
+  }
+
+  // PercentComplete is defined only when total_bytes_ > 0 in Chromium; if it
+  // returns 1–100, recover total from received when possible.
+  const int pct = item->PercentComplete();
+  if (pct > 0 && pct <= 100 && received > 0) {
+    // total ≈ received * 100 / pct (integer). Avoid div-by-zero; pct >= 1.
+    const uint64_t recovered =
+        (received * 100ULL + static_cast<uint64_t>(pct) - 1) /
+        static_cast<uint64_t>(pct);
+    if (recovered >= received) {
+      return recovered;
+    }
+  }
+
+  const scoped_refptr<const net::HttpResponseHeaders> headers =
+      item->GetResponseHeaders();
+  if (headers) {
+    std::optional<base::ByteCount> content_length = headers->GetContentLength();
+    if (content_length.has_value() && content_length->InBytes() > 0) {
+      return static_cast<uint64_t>(content_length->InBytes());
+    }
+  }
+
+  // Completed download with unknown total: treat final size as total so the
+  // last active update before done can show 100% if we emit active first.
+  if (item->GetState() == download::DownloadItem::COMPLETE && received > 0) {
+    return received;
+  }
+
+  return 0;
+}
+
+class TsDownloadProgressObserver : public DownloadManager::Observer,
+                                   public download::DownloadItem::Observer {
+ public:
+  explicit TsDownloadProgressObserver(DownloadManager* manager)
+      : manager_(manager) {
+    manager_->AddObserver(this);
+  }
+
+  ~TsDownloadProgressObserver() override {
+    if (manager_) {
+      manager_->RemoveObserver(this);
+    }
+  }
+
+  void ManagerGoingDown(DownloadManager* manager) override {
+    if (manager_ == manager) {
+      manager_ = nullptr;
+    }
+  }
+
+  void OnDownloadCreated(DownloadManager* manager,
+                         download::DownloadItem* item) override {
+    ObserveItem(item);
+  }
+
+  void OnDownloadUpdated(download::DownloadItem* item) override {
+    NotifyItem(item);
+  }
+
+  void OnDownloadDestroyed(download::DownloadItem* item) override {
+    if (item && !item->IsDone()) {
+      Emit(item, "cancelled");
+    }
+  }
+
+ private:
+  void ObserveItem(download::DownloadItem* item) {
+    if (!item) {
+      return;
+    }
+    item->AddObserver(this);
+    NotifyItem(item);
+  }
+
+  void NotifyItem(download::DownloadItem* item) {
+    if (!item) {
+      return;
+    }
+    switch (item->GetState()) {
+      case download::DownloadItem::IN_PROGRESS:
+        Emit(item, "active");
+        break;
+      case download::DownloadItem::COMPLETE:
+        Emit(item, "done");
+        break;
+      case download::DownloadItem::CANCELLED:
+        Emit(item, "cancelled");
+        break;
+      case download::DownloadItem::INTERRUPTED:
+        Emit(item, "error");
+        break;
+      default:
+        Emit(item, "active");
+        break;
+    }
+  }
+
+  void Emit(download::DownloadItem* item, const char* state) {
+    WebContents* wc = DownloadItemUtils::GetWebContents(item);
+    if (!wc) {
+      return;
+    }
+    const uint64_t received =
+        static_cast<uint64_t>(std::max<int64_t>(0, item->GetReceivedBytes()));
+    // Exp 4: robust total so Content-Length downloads become determinate.
+    const uint64_t total = ResolveDownloadTotalBytes(item, received);
+    TsNotifyDownloadProgress(static_cast<void*>(wc), state, received, total);
+  }
+
+  raw_ptr<DownloadManager> manager_;
+};
+
+void AttachObserver(BrowserContext* browser_context) {
+  if (!browser_context) {
+    return;
+  }
+  DownloadManager* manager = browser_context->GetDownloadManager();
+  if (!manager) {
+    LOG(WARNING) << "[termsurf-download] no DownloadManager for progress";
+    return;
+  }
+  new TsDownloadProgressObserver(manager);
+  LOG(INFO) << "[termsurf-download] progress observer attached";
+}
+
+}  // namespace
+
+void ConfigureTsDownloadProgress(BrowserContext* browser_context) {
+  AttachObserver(browser_context);
+}
+
+void TsNotifyDownloadProgress(void* wc_handle,
+                              const char* state,
+                              uint64_t received_bytes,
+                              uint64_t total_bytes) {
+  if (g_on_download_progress) {
+    g_on_download_progress(wc_handle, state, received_bytes, total_bytes,
+                           g_on_download_progress_data);
+  }
+}
+
+}  // namespace content
