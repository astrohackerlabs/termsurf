+
+#ifndef CONTENT_LIBTERMSURF_CHROMIUM_TS_DOWNLOAD_PROGRESS_H_
+#define CONTENT_LIBTERMSURF_CHROMIUM_TS_DOWNLOAD_PROGRESS_H_
+
+#include <stdint.h>
+
+namespace content {
+
+class BrowserContext;
+
+// Attach DownloadManager observer that emits pane progress callbacks
+// (Issue 26073112048720 Exp 3).
+void ConfigureTsDownloadProgress(BrowserContext* browser_context);
+
+// Fire C callback registered via ts_set_on_download_progress.
+// state: "active" | "done" | "error" | "cancelled"
+// total_bytes == 0 means unknown size → indeterminate surface progress.
+void TsNotifyDownloadProgress(void* wc_handle,
+                              const char* state,
+                              uint64_t received_bytes,
+                              uint64_t total_bytes);
+
+}  // namespace content
+
+#endif  // CONTENT_LIBTERMSURF_CHROMIUM_TS_DOWNLOAD_PROGRESS_H_
