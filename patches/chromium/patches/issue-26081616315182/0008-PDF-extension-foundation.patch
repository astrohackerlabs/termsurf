+void TsBrowserMainParts::InitializeBrowserContexts() {
+  extensions_client_ = std::make_unique<TsExtensionsClient>();
+  extensions::ExtensionsClient::Set(extensions_client_.get());
+  LOG(INFO) << "[issue-792-exp2] extensions-client-set";
+
+  extensions_browser_client_ = std::make_unique<TsExtensionsBrowserClient>();
+  extensions_browser_client_->Init();
+  extensions::ExtensionsBrowserClient::Set(extensions_browser_client_.get());
+  LOG(INFO) << "[issue-792-exp2] extensions-browser-client-set";
+
+  extensions::EnsureBrowserContextKeyedServiceFactoriesBuilt();
+  EnsureTsBrowserContextKeyedServiceFactoriesBuilt();
+  LOG(INFO) << "[issue-792-exp2] keyed-service-factories-built";
+
+  set_browser_context(new ShellBrowserContext(false, true));
+  set_off_the_record_browser_context(new ShellBrowserContext(true, true));
+
+  InitializeExtensionContext(browser_context(), false);
+  InitializeExtensionContext(off_the_record_browser_context(), true);
+  extensions_browser_client_->SetOffTheRecordContext(
+      browser_context(), off_the_record_browser_context());
+
+  // Issue 792 Exp 2 only creates the full keyed-service graph for the regular
+  // context. The inherited off-the-record context has enough extension state
+  // for context routing, but PDF component-extension enablement remains a
+  // regular-context slice until the PDF API providers are in place.
+  BrowserContextDependencyManager::GetInstance()->CreateBrowserContextServices(
+      browser_context());
+
+  extensions::EventRouter::Get(browser_context());
+
+  browser_context()->GetOriginTrialsControllerDelegate();
+  off_the_record_browser_context()->GetOriginTrialsControllerDelegate();
+}
+
+void TsBrowserMainParts::PostMainMessageLoopRun() {
+  ShellBrowserMainParts::PostMainMessageLoopRun();
+  extension_pref_services_.clear();
+}
+
+void TsBrowserMainParts::PostDestroyThreads() {
+  extensions::ExtensionsBrowserClient::Set(nullptr);
+  extensions_browser_client_.reset();
+  extensions::ExtensionsClient::Set(nullptr);
+  extensions_client_.reset();
+  ShellBrowserMainParts::PostDestroyThreads();
+}
+
+void TsBrowserMainParts::InitializeExtensionContext(
+    ShellBrowserContext* context,
+    bool in_memory) {
+  auto pref_service =
+      CreateTsExtensionPrefService(context, context->GetPath(), in_memory);
+  PrefService* pref_service_ptr = pref_service.get();
+  extension_pref_services_[context] = std::move(pref_service);
+  extensions_browser_client_->RegisterContext(context, pref_service_ptr);
+  LOG(INFO) << "[issue-792-exp2] extension-prefs-ready context=" << context
+            << " prefs=" << pref_service_ptr;
+
+  auto* extension_system = static_cast<TsExtensionSystem*>(
+      extensions::ExtensionSystem::Get(context));
+  CHECK(extension_system);
+  extension_system->InitForRegularProfile(/*extensions_enabled=*/true);
+  LOG(INFO) << "[issue-792-exp2] extension-system-init-for-regular-profile"
+            << " context=" << context;
+  extension_system->FinishInitialization();
+  LOG(INFO) << "[issue-792-exp2] extension-system-finish-initialization"
+            << " context=" << context;
+
+  auto* registry = extensions::ExtensionRegistry::Get(context);
+  LOG(INFO) << "[issue-792-exp2] extension-system-ready context=" << context
+            << " registry=" << registry
+            << " is_ready=" << extension_system->is_ready();
+}
