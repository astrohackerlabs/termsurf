+void AllowPdfViewerChromeResources() {
+  // Renderer setup cannot consult the ExtensionRegistry, so keep this
+  // process-wide rule keyed to the fixed PDF extension origin.
+  blink::WebURL pdf_viewer_origin =
+      GURL(std::string(extensions::kExtensionScheme) + "://" +
+           extension_misc::kPdfExtensionId);
+  blink::WebSecurityPolicy::AddOriginAccessAllowListEntry(
+      pdf_viewer_origin, blink::WebString::FromUTF8(kChromeUIScheme),
+      blink::WebString::FromUTF8(kChromeUIResourcesHost), /*port=*/0,
+      network::mojom::CorsDomainMatchMode::kDisallowSubdomains,
+      network::mojom::CorsPortMatchMode::kAllowAnyPort,
+      network::mojom::CorsOriginAccessMatchPriority::kMaxPriority);
+  LOG(INFO) << "[issue-792-exp7] chrome-resources-renderer-origin extension_id="
+            << extension_misc::kPdfExtensionId;
+}
+
+}  // namespace
+
+TsContentRendererClient::TsContentRendererClient() = default;
+TsContentRendererClient::~TsContentRendererClient() = default;
+
+void TsContentRendererClient::RenderThreadStarted() {
+  ShellContentRendererClient::RenderThreadStarted();
+
+  extensions_client_ = std::make_unique<TsExtensionsClient>();
+  extensions::ExtensionsClient::Set(extensions_client_.get());
+
+  extensions_renderer_client_ = std::make_unique<TsExtensionsRendererClient>();
+  extensions_renderer_client_->AddAPIProvider(
+      std::make_unique<extensions::CoreExtensionsRendererAPIProvider>());
+  extensions::ExtensionsRendererClient::Set(extensions_renderer_client_.get());
+  extensions_renderer_client_->RenderThreadStarted();
+  AllowPdfViewerChromeResources();
+  LOG(INFO) << "[issue-792-exp2] extensions-renderer-client-set";
+}
+
+void TsContentRendererClient::RenderFrameCreated(RenderFrame* render_frame) {
+  ShellContentRendererClient::RenderFrameCreated(render_frame);
+
+  // ExtensionFrameHelper destroys itself when the RenderFrame is destroyed.
+  new extensions::ExtensionFrameHelper(render_frame, dispatcher());
+  dispatcher()->OnRenderFrameCreated(render_frame);
+}
+
+bool TsContentRendererClient::OverrideCreatePlugin(
+    RenderFrame* render_frame,
+    const blink::WebPluginParams& params,
+    blink::WebPlugin** plugin) {
+  if (extensions_renderer_client_ &&
+      extensions_renderer_client_->OverrideCreatePlugin(render_frame, params)) {
+    return false;
+  }
+  return ShellContentRendererClient::OverrideCreatePlugin(render_frame, params,
+                                                          plugin);
+}
+
+void TsContentRendererClient::RunScriptsAtDocumentStart(
+    RenderFrame* render_frame) {
+  dispatcher()->RunScriptsAtDocumentStart(render_frame);
+}
+
+void TsContentRendererClient::RunScriptsAtDocumentEnd(
+    RenderFrame* render_frame) {
+  dispatcher()->RunScriptsAtDocumentEnd(render_frame);
+}
+
+extensions::Dispatcher* TsContentRendererClient::dispatcher() {
+  CHECK(extensions_renderer_client_);
+  return extensions_renderer_client_->dispatcher();
+}
+
+}  // namespace content
