+base::FilePath TsExtensionsBrowserClient::GetBundleResourcePath(
+    const network::ResourceRequest& request,
+    const base::FilePath& extension_resources_path,
+    int* resource_id) const {
+  *resource_id = 0;
+  if (!request.url.SchemeIs(extensions::kExtensionScheme) ||
+      request.url.host() != extension_misc::kPdfExtensionId) {
+    return {};
+  }
+
+  const base::FilePath resource_relative_path =
+      extensions::file_util::ExtensionURLToRelativeFilePath(request.url);
+  const bool found =
+      component_extension_resource_manager_->IsComponentExtensionResource(
+          base::FilePath(FILE_PATH_LITERAL("pdf")), resource_relative_path,
+          resource_id);
+  LOG(INFO) << "[issue-792-exp5] bundle-resource url=" << request.url
+            << " path=" << resource_relative_path.AsUTF8Unsafe()
+            << " resource_id=" << *resource_id << " found=" << found;
+  return found ? resource_relative_path : base::FilePath();
+}
