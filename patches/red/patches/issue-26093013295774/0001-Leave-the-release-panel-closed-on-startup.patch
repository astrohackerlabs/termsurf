From 3e1c44d2578a4eda654343a31610a3db5087dc57 Mon Sep 17 00:00:00 2001
From: "Ryan X. Charles" <ryan@ryanxcharles.com>
Date: Wed, 30 Sep 2026 08:39:55 -0500
Subject: [PATCH] Leave the release panel closed on startup

Startup no longer opens What's new unless show_whats_new is true.
:whats-new and :changelog still open the panel.
---
 README.md                                     | 13 +++--
 .../reference/configuration/default-config.md |  2 +-
 default_config.toml                           |  5 +-
 src/config.rs                                 |  4 +-
 src/editor.rs                                 | 52 ++++++++++++++++++-
 5 files changed, 63 insertions(+), 13 deletions(-)

diff --git a/README.md b/README.md
index 10352ff1e88c52e5c45aae1328be496bd2e1ac7c..05f1af910b87b432ca0d51cbdaa5b203a5576432 100644
--- a/README.md
+++ b/README.md
@@ -197,10 +197,10 @@ The current release includes:
 See the [latest release notes](https://github.com/codersauce/red/releases/latest)
 or the [complete changelog](CHANGELOG.md) for details.
 
-After installing a new version, Red opens a themed **What’s new** panel once.
-Reopen it whenever you like with `:whats-new`, `:changelog`, or the command
-palette. Release notes are bundled for offline use and refreshed from the exact
-matching GitHub release in the background.
+Startup does not open the **What’s new** panel. Open it with `:whats-new`,
+`:changelog`, or the command palette. Set `show_whats_new = true` to show it
+once after a version you have not seen. Release notes are bundled for offline
+use and refreshed from the exact matching GitHub release when the panel opens.
 
 ## Configuration
 
@@ -211,9 +211,8 @@ contain only the values you want to change:
 # ~/.config/astrohacker/redvim/config.toml
 theme = "red.json"
 scrolloff = 8
-# Disable the automatic release panel or its optional GitHub refresh:
-# show_whats_new = false
-# fetch_release_notes = false
+# Show the release panel once for a version that has not been seen:
+# show_whats_new = true
 
 [search]
 ignorecase = true
diff --git a/almanac/reference/configuration/default-config.md b/almanac/reference/configuration/default-config.md
index dea3cdcffe18577d45929de5ccece7843bd13c47..611ac91c01ab38f92327c976b34c7294c0089f1c 100644
--- a/almanac/reference/configuration/default-config.md
+++ b/almanac/reference/configuration/default-config.md
@@ -38,7 +38,7 @@ The top-level schema accepts keys for editor behavior, keymaps, theme, cursor, p
 | `sidescroll` | `1` | Horizontal scroll step when wrapping is off [@defaults]. |
 | `sidescrolloff` | `0` | Preferred visible columns beside the cursor [@defaults]. |
 | `splash` | `true` | Show the startup splash when Red opens without file arguments [@defaults]. |
-| `show_whats_new` | `true` | Present a themed release announcement once after a newly installed version starts interactively [@defaults] [@config]. |
+| `show_whats_new` | `false` | Leave the release panel closed on startup unless the user sets it true [@defaults] [@config]. |
 | `fetch_release_notes` | `true` | Refresh bundled release notes from GitHub without blocking editor startup [@defaults] [@config]. |
 | `persist_inline_history` | `true` | Keep inline questions and answers in local editor recovery snapshots [@defaults] [@config]. |
 | `log_file` | `"red.log"` | Default log file name under the config directory [@defaults]. |
