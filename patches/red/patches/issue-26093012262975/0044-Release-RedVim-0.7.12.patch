From 8a485efa37a258fba39b5ea9cbfa8f44767d5afc Mon Sep 17 00:00:00 2001
From: "Ryan X. Charles" <ryan@ryanxcharles.com>
Date: Wed, 30 Sep 2026 08:07:49 -0500
Subject: [PATCH] Release RedVim 0.7.12

---
 Cargo.lock                   | 2 +-
 Cargo.toml                   | 2 +-
 REDVIM_CHANGELOG.md          | 6 ++++++
 release/redvim-campaign.toml | 2 +-
 4 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 4d832ab..2808ce0 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -2312,7 +2312,7 @@ dependencies = [
 
 [[package]]
 name = "red"
-version = "0.7.11"
+version = "0.7.12"
 dependencies = [
  "anyhow",
  "arboard",
diff --git a/Cargo.toml b/Cargo.toml
index 51b9bc2..1a856e2 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,6 +1,6 @@
 [package]
 name = "red"
-version = "0.7.11"
+version = "0.7.12"
 edition = "2021"
 default-run = "redvim"
 autobins = false
diff --git a/REDVIM_CHANGELOG.md b/REDVIM_CHANGELOG.md
index 5de83ec..891baac 100644
--- a/REDVIM_CHANGELOG.md
+++ b/REDVIM_CHANGELOG.md
@@ -1,5 +1,11 @@
 # RedVim changelog
 
+## [0.7.12]
+
+### Maintenance
+
+- Publish the pinned RedVim source as version 0.7.12, retaining bundled Nushell support.
+
 ## [0.7.11]
 
 ### Maintenance
diff --git a/release/redvim-campaign.toml b/release/redvim-campaign.toml
index 26bce36..eb30c3d 100644
--- a/release/redvim-campaign.toml
+++ b/release/redvim-campaign.toml
@@ -1,4 +1,4 @@
-version = "0.7.11"
+version = "0.7.12"
 
 [[stories]]
 title = "Edit Nushell with bundled syntax highlighting"
-- 
2.54.0 (Apple Git-157)

