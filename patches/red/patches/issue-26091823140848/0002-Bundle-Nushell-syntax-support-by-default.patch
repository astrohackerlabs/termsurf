+    #[tokio::test]
+    async fn nu_defaults_comment_indent_and_user_overrides() {
+        let mut editor = test_editor(80, 12);
+        editor.buffer_manager[0] =
+            Buffer::new(Some("example.nu".into()), "let answer = 42\n".into());
