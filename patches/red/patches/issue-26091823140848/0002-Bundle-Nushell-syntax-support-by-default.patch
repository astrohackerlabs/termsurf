+        let mut editor = rust_test_editor(100, 120, 22);
+        editor.buffer_manager[0] =
+            Buffer::new(Some("example.nu".into()), "let answer = 42\n".into());
+        let before = editor.viewport_highlight_spans(0, 0, 10).unwrap();
+        assert!(!before.is_empty());
+        assert_eq!(
+            editor.highlight_cache[&0].language_id.as_deref(),
+            Some("nu")
+        );
+        editor.current_buffer_mut().insert_str(0, 0, "# ");
+        let after = editor.viewport_highlight_spans(0, 0, 10).unwrap();
+        let shape = |spans: &[HighlightSpan]| {
+            spans
+                .iter()
+                .map(|s| (s.start, s.end, s.style.clone()))
+                .collect::<Vec<_>>()
+        };
+        assert_ne!(shape(&before), shape(&after));
+        editor.current_buffer_mut().file = Some("notes.txt".into());
+        editor
+            .current_buffer_mut()
+            .set_syntax_selection(SyntaxSelection::Language("nu".into()));
+        assert!(!editor
+            .viewport_highlight_spans(0, 0, 10)
+            .unwrap()
+            .is_empty());
+        assert_eq!(editor.current_language_id().as_deref(), Some("nu"));
+    }
