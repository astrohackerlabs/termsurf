+    #[test]
+    fn nu_bundled_parser_queries_and_theme_highlight_real_syntax() {
+        let code = include_str!("queries/highlights/nu-smoke.nu");
+        let language = tree_sitter_nu::LANGUAGE.into();
+        let mut parser = Parser::new();
+        parser.set_language(&language).unwrap();
+        let tree = parser.parse(code, None).unwrap();
+        assert!(
+            !tree.root_node().has_error(),
+            "{}",
+            tree.root_node().to_sexp()
+        );
+        let theme = parse_vscode_theme("themes/mocha.json").unwrap();
+        let mut highlighter = Highlighter::new(&theme).unwrap();
+        let styles = highlighter
+            .highlight_for_file(Some("example.nu"), code)
+            .unwrap();
+        for (token, scope) in [
+            ("# café", "comment"),
+            ("def", "keyword.function"),
+            ("greet", "function"),
+            ("let", "keyword"),
+            ("if", "keyword.conditional"),
+            ("Hello", "string"),
+            ("name)", "variable"),
+            ("5sec", "number"),
+            ("| str", "operator"),
+            ("each", "function.builtin"),
+            ("loud]", "attribute"),
+        ] {
+            let expected = theme
+                .get_style(scope)
+                .unwrap_or_else(|| panic!("missing {scope}"));
+            let actual = effective_style_at(&styles, code.find(token).unwrap());
+            assert_eq!(actual, Some(&expected), "{token}: {scope}");
+            if scope != "variable" {
+                assert_ne!(expected.fg, theme.style.fg, "{scope} needs a visible color");
+            }
+        }
+    }
+
+    #[test]
