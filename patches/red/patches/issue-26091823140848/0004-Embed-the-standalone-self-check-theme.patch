From ca6698a5163dfc3b1246eb8cc5ed61bba5b1e2ab Mon Sep 17 00:00:00 2001
From: "Ryan X. Charles" <ryan@ryanxcharles.com>
Date: Sat, 19 Sep 2026 06:15:01 -0500
Subject: [PATCH] Embed the standalone self-check theme

The source tree fades beyond the shore.
Our pocket theme asks it no more.
---
 src/main.rs              | 2 +-
 tests/redvim_identity.rs | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/main.rs b/src/main.rs
index ebc562f..30ca48e 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -118,7 +118,7 @@ async fn run() -> anyhow::Result<()> {
     if args.self_check {
         let report = run_self_check().await?;
         println!("{}", report.format());
-        let theme = red::theme::parse_vscode_theme("themes/mocha.json")?;
+        let theme = parse_vscode_theme_contents(include_str!("../themes/mocha.json"))?;
         let mut highlighter = red::highlighter::Highlighter::new(&theme)?;
         let fixture = include_str!("queries/highlights/nu-smoke.nu");
         anyhow::ensure!(
diff --git a/tests/redvim_identity.rs b/tests/redvim_identity.rs
index 66d83e0..b659f88 100644
--- a/tests/redvim_identity.rs
+++ b/tests/redvim_identity.rs
@@ -15,6 +15,7 @@ fn redvim_identity_and_configuration_are_independent_of_red() {
     ] {
         let output = Command::new(env!("CARGO_BIN_EXE_redvim"))
             .args(args)
+            .current_dir(root.path())
             .env("XDG_CONFIG_HOME", root.path())
             .env("HOME", root.path())
             .env("RED_RUNTIME", root.path().join("missing-runtime"))
