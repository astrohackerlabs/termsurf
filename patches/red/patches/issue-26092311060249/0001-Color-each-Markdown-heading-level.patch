+        assert_eq!(style_covering(&styles, code, "#"), Some(&heading));
+        assert_eq!(style_covering(&styles, code, "Title"), Some(&heading));
     }
 
     fn style_covering<'a>(styles: &'a [StyleInfo], code: &str, token: &str) -> Option<&'a Style> {
