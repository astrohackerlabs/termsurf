From 948be39dd7912760ec8111197fcbb912d06274c7 Mon Sep 17 00:00:00 2001
From: "Ryan X. Charles" <ryan@ryanxcharles.com>
Date: Sat, 10 Oct 2026 04:59:27 -0500
Subject: [PATCH] Fit upstream tests to TermSurf defaults

Two upstream tests assumed upstream defaults. The BOM config test saw a
diagnostic for TermSurf's bundled Austin Night theme, which unit tests
cannot resolve, so it clears the theme before checking diagnostics. The
menu unbind test now also unbinds TermSurf's super+l split binding and
expects super+l, the product's Split Right shortcut, after reload.
---
 macos/Tests/Ghostty/MenuShortcutManagerTests.swift | 6 ++++--
 src/config/Config.zig                              | 6 ++++++
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/macos/Tests/Ghostty/MenuShortcutManagerTests.swift b/macos/Tests/Ghostty/MenuShortcutManagerTests.swift
index ab8806b9b16228ca8afd6e26e4dd581f341bb7a5..17baf6334a16538d9bc7cf5761bef0ec06623eac 100644
--- a/macos/Tests/Ghostty/MenuShortcutManagerTests.swift
+++ b/macos/Tests/Ghostty/MenuShortcutManagerTests.swift
@@ -6,7 +6,8 @@ import Testing
 struct MenuShortcutManagerTests {
     @Test(.bug("https://github.com/ghostty-org/ghostty/issues/779", id: 779))
     func unbindShouldDiscardDefault() async throws {
-        let config = try TemporaryConfig("keybind = super+d=unbind")
+        // TermSurf also binds super+l to new_split:right; unbind both defaults.
+        let config = try TemporaryConfig("keybind = super+d=unbind\nkeybind = super+l=unbind")
 
         let item = NSMenuItem(title: "Split Right", action: #selector(BaseTerminalController.splitRight(_:)), keyEquivalent: "d")
         item.keyEquivalentModifierMask = .command
@@ -22,7 +23,8 @@ struct MenuShortcutManagerTests {
         await manager.reset()
         await manager.syncMenuShortcut(config, action: "new_split:right", menuItem: item)
 
-        #expect(item.keyEquivalent == "d")
+        // TermSurf product keybinds make super+l the Split Right menu default.
+        #expect(item.keyEquivalent == "l")
         #expect(item.keyEquivalentModifierMask == .command)
     }
 
diff --git a/src/config/Config.zig b/src/config/Config.zig
index 9c1b283bbfb96d7e349b151c66fa023b83616ee3..d12b209a783f82620f861c13a706f2871947c97b 100644
--- a/src/config/Config.zig
+++ b/src/config/Config.zig
@@ -4142,6 +4142,9 @@ test "handle bom in config files" {
         var reader: std.Io.Reader = .fixed(data);
         var cfg = try Config.default(alloc);
         defer cfg.deinit();
+        // TermSurf defaults to the bundled Austin Night theme, which unit
+        // tests cannot resolve (no resources dir); keep BOM diagnostics pure.
+        cfg.theme = null;
         try cfg.loadReader(
             alloc,
             &reader,
@@ -4161,6 +4164,9 @@ test "handle bom in config files" {
         var reader: std.Io.Reader = .fixed(data);
         var cfg = try Config.default(alloc);
         defer cfg.deinit();
+        // TermSurf defaults to the bundled Austin Night theme, which unit
+        // tests cannot resolve (no resources dir); keep BOM diagnostics pure.
+        cfg.theme = null;
         try cfg.loadReader(
             alloc,
             &reader,
