+    if (paths.len == 0 and !std.mem.eql(u8, phase, "leave") and !std.mem.eql(u8, phase, "over")) {
+        return false;
+    }
     const snapshot = snapshotBrowserInput(pane_id, false) orelse {
         log.warn("ExternalFileDrop: no browser snapshot pane_id={s}", .{pane_id});
         return false;
@@ -5349,7 +5354,7 @@ pub fn externalFileDrop(
         for (owned_paths) |p| allocator.free(p);
         allocator.free(owned_paths);
     }
-    var path_c_ptrs: [][*]u8 = allocator.alloc([*]u8, paths.len) catch return false;
+    var path_c_ptrs: [][*]u8 = allocator.alloc([*]u8, @max(paths.len, 1)) catch return false;
     defer allocator.free(path_c_ptrs);
 
     for (paths, 0..) |path, i| {
@@ -5357,13 +5362,17 @@ pub fn externalFileDrop(
         path_c_ptrs[i] = owned_paths[i].ptr;
     }
 
