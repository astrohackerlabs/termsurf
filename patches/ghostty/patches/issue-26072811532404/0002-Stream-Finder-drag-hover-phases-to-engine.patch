@@ -3804,6 +3804,53 @@ extension Ghostty.SurfaceView {
     .URL,
   ]
 
+  /// Browser-overlay client point for host-mediated file drag (top-left origin DIP).
+  private func termsurfBrowserWebPoint(for sender: any NSDraggingInfo) -> CGPoint? {
+    guard let overlayFrame = termsurfOverlayFrame else { return nil }
+    let viewPoint = convert(sender.draggingLocation, from: nil)
+    let topOriginPoint = CGPoint(x: viewPoint.x, y: bounds.height - viewPoint.y)
+    return CGPoint(
+      x: topOriginPoint.x - overlayFrame.minX,
+      y: topOriginPoint.y - overlayFrame.minY)
+  }
+
+  private func termsurfFilePaths(from pb: NSPasteboard) -> [String] {
+    guard let urls = pb.readObjects(forClasses: [NSURL.self]) as? [URL] else {
+      return []
+    }
+    return urls.filter { $0.isFileURL }.map { $0.path }
+  }
+
+  /// Forward Finder file drag phase into Chromium (Exp 4 hover + Exp 3 drop).
+  @discardableResult
+  private func termsurfSendExternalFileDrag(
+    phase: String,
+    filePaths: [String],
+    webPoint: CGPoint
+  ) -> Bool {
+    var cPaths: [UnsafeMutablePointer<CChar>?] = filePaths.map { strdup($0) }
+    defer {
+      for ptr in cPaths {
+        if let ptr { free(ptr) }
+      }
+    }
+    let ok = cPaths.withUnsafeMutableBufferPointer { ptrBuf -> Int32 in
+      // Zig export expects const char**; match file-chooser path.
+      let constBuf = UnsafeMutableRawPointer(ptrBuf.baseAddress)
+        .map { $0.assumingMemoryBound(to: UnsafePointer<CChar>?.self) }
+      return phase.withCString { phaseC in
+        termsurf_external_file_drop(
+          self.id.uuidString,
+          constBuf,
+          ptrBuf.count,
+          Double(webPoint.x),
+          Double(webPoint.y),
+          phaseC)
+      }
+    }
+    return ok != 0
+  }
+
   override func draggingEntered(_ sender: any NSDraggingInfo) -> NSDragOperation {
     guard let types = sender.draggingPasteboard.types else { return [] }
 
@@ -3814,44 +3861,53 @@ extension Ghostty.SurfaceView {
       return []
     }
 
+    // Browser overlay: stream enter so the page can highlight drop targets.
+    if let webPoint = termsurfBrowserWebPoint(for: sender) {
+      let filePaths = termsurfFilePaths(from: sender.draggingPasteboard)
+      if !filePaths.isEmpty {
+        _ = termsurfSendExternalFileDrag(
+          phase: "enter", filePaths: filePaths, webPoint: webPoint)
+      }
+    }
+
     // We use copy to get the proper icon
     return .copy
   }
 
+  override func draggingUpdated(_ sender: any NSDraggingInfo) -> NSDragOperation {
+    guard let types = sender.draggingPasteboard.types else { return [] }
+    if Set(types).isDisjoint(with: Self.dropTypes) {
+      return []
+    }
+
+    if let webPoint = termsurfBrowserWebPoint(for: sender) {
+      let filePaths = termsurfFilePaths(from: sender.draggingPasteboard)
+      // over may reuse session paths in the engine when pasteboard is empty.
+      _ = termsurfSendExternalFileDrag(
+        phase: "over", filePaths: filePaths, webPoint: webPoint)
+    }
+    return .copy
+  }
+
+  override func draggingExited(_ sender: (any NSDraggingInfo)?) {
+    guard let sender else { return }
+    if let webPoint = termsurfBrowserWebPoint(for: sender) {
+      _ = termsurfSendExternalFileDrag(
+        phase: "leave", filePaths: [], webPoint: webPoint)
+    }
+  }
+
   override func performDragOperation(_ sender: any NSDraggingInfo) -> Bool {
     let pb = sender.draggingPasteboard
 
