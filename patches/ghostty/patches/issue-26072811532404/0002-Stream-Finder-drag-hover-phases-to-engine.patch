+            .{ snapshot.paneId(), snapshot.tab_id, phase, err },
         );
         return false;
     };
     log.info(
-        "ExternalFileDrop: pane_id={s} tab_id={} paths={} x={d:.1} y={d:.1}",
-        .{ snapshot.paneId(), snapshot.tab_id, paths.len, x, y },
