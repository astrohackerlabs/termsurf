-/// Finder/OS file drop onto browser overlay → ExternalFileDrop on engine.
+/// Finder/OS file drag phase onto browser overlay → ExternalFileDrop on engine.
+/// phase: "enter"|"over"|"leave"|"drop" (NULL => "drop").
 pub export fn termsurf_external_file_drop(
     pane_id: [*:0]const u8,
     paths: ?[*]?[*:0]const u8,
     path_count: usize,
     x: f64,
     y: f64,
+    phase: ?[*:0]const u8,
 ) c_int {
     var path_slices: [64][]const u8 = undefined;
     const n = @min(path_count, path_slices.len);
-    if (paths == null or n == 0) return 0;
-    const path_array = paths.?;
-    var i: usize = 0;
-    while (i < n) : (i += 1) {
-        if (path_array[i]) |p| {
-            path_slices[i] = std.mem.span(p);
-        } else {
-            path_slices[i] = "";
+    if (paths != null and n > 0) {
+        const path_array = paths.?;
+        var i: usize = 0;
+        while (i < n) : (i += 1) {
+            if (path_array[i]) |p| {
+                path_slices[i] = std.mem.span(p);
+            } else {
+                path_slices[i] = "";
+            }
         }
     }
-    return if (termsurf.externalFileDrop(std.mem.span(pane_id), path_slices[0..n], x, y))
+    const phase_slice: []const u8 = if (phase) |p| std.mem.span(p) else "drop";
+    return if (termsurf.externalFileDrop(
+        std.mem.span(pane_id),
+        if (n > 0) path_slices[0..n] else &.{},
+        x,
+        y,
+        phase_slice,
+    ))
         1
     else
         0;
