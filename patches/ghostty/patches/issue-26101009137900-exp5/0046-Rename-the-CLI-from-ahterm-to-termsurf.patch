 .../ghostty-shell-integration.fish            |  4 ++--
 .../nushell/vendor/autoload/ghostty.nu        |  6 ++---
 src/shell-integration/zsh/ghostty-integration |  4 ++--
 18 files changed, 60 insertions(+), 60 deletions(-)

