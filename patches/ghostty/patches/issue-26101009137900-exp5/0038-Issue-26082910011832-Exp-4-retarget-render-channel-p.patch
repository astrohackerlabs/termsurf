Subject: [PATCH 38/45] Issue 26082910011832 Exp 4: retarget render-channel
 path

Include code/termsurf/render-channel after bun+rust flatten.
---
 src/build/SharedDeps.zig | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/build/SharedDeps.zig b/src/build/SharedDeps.zig
index 04bbd85ea6d5991135637553934bdcab2b7836fe..7ceab27f784e2f33b32d0822cb85fcf47f7cc866 100644
--- a/src/build/SharedDeps.zig
+++ b/src/build/SharedDeps.zig
@@ -483,13 +483,13 @@ pub fn add(
     });
     // Zig 0.16: C includes/sources hang off root_module (not Compile step).
     step.root_module.addIncludePath(b.path("src/protobuf"));
-    step.root_module.addIncludePath(b.path("../../rust/termsurf/render-channel"));
+    step.root_module.addIncludePath(b.path("../../code/termsurf/render-channel"));
     step.root_module.addCSourceFiles(.{ .files = &.{
         "src/protobuf/protobuf-c.c",
         "src/protobuf/termsurf.pb-c.c",
     } });
     step.root_module.addCSourceFile(.{
-        .file = b.path("../../rust/termsurf/render-channel/termsurf_render_channel.c"),
+        .file = b.path("../../code/termsurf/render-channel/termsurf_render_channel.c"),
         .flags = &.{"-std=c99"},
     });
     if (step.rootModuleTarget().os.tag == .linux) {
