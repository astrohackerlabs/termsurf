From: "Ryan X. Charles" <ryan@ryanxcharles.com>
Date: Sun, 26 Jul 2026 14:23:26 -0500
Subject: [PATCH 55/75] Harden Zig 0.16 TermSurf env, sockets, and tests

Inject TERMSURF_SOCKET into defaultTermioEnv, retry EINTR on
accept/write/connect, set Darwin sun_len, restore XDG/env tests.
---
 src/apprt/embedded.zig   |   6 ++
 src/apprt/termsurf.zig   | 116 +++++++++++++++++++++++++++++++++------
 src/config/file_load.zig |  39 +++++++++----
 src/crash/dir.zig        |  11 ----
 4 files changed, 134 insertions(+), 38 deletions(-)

diff --git a/src/apprt/embedded.zig b/src/apprt/embedded.zig
index 61e86118e..da4ffa0d7 100644
--- a/src/apprt/embedded.zig
+++ b/src/apprt/embedded.zig
@@ -997,6 +997,12 @@ pub const Surface = struct {
             if (internal_os.launchedFromDesktop()) _ = env.orderedRemove("LANGUAGE");
         }
 
+        // Astrohacker TermSurf: IPC start uses libc setenv after global env
+        // cache init (Zig 0.16). Explicitly inject TERMSURF_SOCKET so shell
+        // children and ahweb/ahsh always see the listening path.
+        const termsurf = @import("termsurf.zig");
+        try termsurf.ensureSocketInEnv(&env);
+
         return env;
     }
 
