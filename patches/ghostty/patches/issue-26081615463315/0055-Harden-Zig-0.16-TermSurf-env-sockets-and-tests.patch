 }
 
-fn pbindUnix(fd: std.posix.fd_t, path_z: [:0]const u8) !void {
-    var addr: c.struct_sockaddr_un = std.mem.zeroes(c.struct_sockaddr_un);
+fn fillUnixAddr(path_z: [:0]const u8, addr: *c.struct_sockaddr_un) !c.socklen_t {
+    addr.* = std.mem.zeroes(c.struct_sockaddr_un);
     addr.sun_family = c.AF_UNIX;
     if (path_z.len >= addr.sun_path.len) return error.NameTooLong;
     @memcpy(addr.sun_path[0..path_z.len], path_z);
     addr.sun_path[path_z.len] = 0;
     const path_len = path_z.len + 1;
     const addr_len: c.socklen_t = @intCast(@offsetOf(c.struct_sockaddr_un, "sun_path") + path_len);
+    // BSD/Darwin sockaddr_un includes sun_len; Zig Address.initUnix set this.
+    if (comptime builtin.os.tag.isDarwin()) {
+        addr.sun_len = @intCast(addr_len);
+    }
+    return addr_len;
+}
+
+fn pbindUnix(fd: std.posix.fd_t, path_z: [:0]const u8) !void {
+    var addr: c.struct_sockaddr_un = undefined;
+    const addr_len = try fillUnixAddr(path_z, &addr);
     if (c.bind(fd, @ptrCast(&addr), addr_len) != 0) return error.BindFailed;
 }
 
@@ -54,20 +64,27 @@ fn plisten(fd: std.posix.fd_t, backlog: c_int) !void {
 }
 
 fn paccept(fd: std.posix.fd_t) !std.posix.fd_t {
-    const rc = c.accept(fd, null, null);
-    if (rc < 0) return error.AcceptFailed;
-    return @intCast(rc);
+    while (true) {
+        const rc = c.accept(fd, null, null);
+        if (rc >= 0) return @intCast(rc);
+        switch (std.posix.errno(rc)) {
+            .INTR => continue,
+            else => return error.AcceptFailed,
+        }
+    }
 }
 
 fn pconnectUnix(fd: std.posix.fd_t, path_z: [:0]const u8) !void {
-    var addr: c.struct_sockaddr_un = std.mem.zeroes(c.struct_sockaddr_un);
-    addr.sun_family = c.AF_UNIX;
-    if (path_z.len >= addr.sun_path.len) return error.NameTooLong;
-    @memcpy(addr.sun_path[0..path_z.len], path_z);
-    addr.sun_path[path_z.len] = 0;
-    const path_len = path_z.len + 1;
-    const addr_len: c.socklen_t = @intCast(@offsetOf(c.struct_sockaddr_un, "sun_path") + path_len);
-    if (c.connect(fd, @ptrCast(&addr), addr_len) != 0) return error.ConnectFailed;
+    var addr: c.struct_sockaddr_un = undefined;
+    const addr_len = try fillUnixAddr(path_z, &addr);
+    while (true) {
+        const rc = c.connect(fd, @ptrCast(&addr), addr_len);
+        if (rc == 0) return;
+        switch (std.posix.errno(rc)) {
+            .INTR => continue,
+            else => return error.ConnectFailed,
+        }
+    }
 }
 
