 fn httpStatusLine(response: []const u8) ?[]const u8 {
     if (std.mem.indexOf(u8, response, "\r\n")) |end| return response[0..end];
-    if (std.mem.indexOfScalar(u8, response, '\n')) |end| return std.mem.trimRight(u8, response[0..end], "\r");
+    if (std.mem.indexOfScalar(u8, response, '\n')) |end| return std.mem.trimEnd(u8, response[0..end], "\r");
     return null;
 }
 
@@ -4983,7 +5035,12 @@ fn writeAll(fd: std.posix.fd_t, bytes: []const u8) !void {
     var offset: usize = 0;
     while (offset < bytes.len) {
         const rc = std.posix.system.write(fd, bytes[offset..].ptr, bytes.len - offset);
-        if (rc < 0) return error.WriteFailed;
+        if (rc < 0) {
+            switch (std.posix.errno(rc)) {
+                .INTR => continue,
+                else => return error.WriteFailed,
+            }
+        }
         if (rc == 0) return error.WriteZero;
         offset += @intCast(rc);
     }
@@ -5075,6 +5132,25 @@ fn socketPath(tmpdir: []const u8, sep: []const u8) ![:0]u8 {
     return path_z;
 }
 
+
+test "ensureSocketInEnv injects TERMSURF_SOCKET into termio env map" {
+    const testing = std.testing;
+    testingClearListeningSocketPath();
+    defer testingClearListeningSocketPath();
+
+    const known = "/tmp/termsurf-exp3-socket-env-test.sock";
+    try testingSetListeningSocketPath(known);
+
+    // Simulate defaultTermioEnv: map from global/testing environ, then product inject.
+    var env = try global.environMap();
+    defer env.deinit();
+    // Ensure key is not already required from ambient env for this assertion path:
+    _ = env.orderedRemove(env_key);
+    try ensureSocketInEnv(&env);
+    const got = env.get(env_key) orelse return error.TestExpectedEqual;
+    try testing.expectEqualStrings(known, got);
+}
+
 test "termsurf server register matches profile and browser" {
     const testing = std.testing;
 
@@ -5791,8 +5867,14 @@ fn testWithRestoredEnv(name: [:0]const u8, callback: *const fn () anyerror!void)
     try callback();
 }
 
-fn removeTmpTree(_: []const u8) void {
-    // Best-effort cleanup omitted under Zig 0.16 Dir API churn.
+fn removeTmpTree(path: []const u8) void {
+    const prefix = "/tmp/";
+    if (!std.mem.startsWith(u8, path, prefix)) return;
+    const rel = path[prefix.len..];
+    if (rel.len == 0) return;
+    var tmp = std.Io.Dir.openDirAbsolute(global.io(), "/tmp", .{}) catch return;
+    defer tmp.close(global.io());
+    tmp.deleteTree(global.io(), rel) catch {};
 }
 
