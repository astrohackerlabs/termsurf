+test "astrohacker termsurf xdg config path is the default" {
+    if (@import("builtin").os.tag == .windows) return error.SkipZigTest;
+
+    const alloc = std.testing.allocator;
+    const xdg_config_home = "/tmp/astrohacker-terminal-test-xdg-config";
+    const saved_xdg_config_home = if (std.posix.getenv("XDG_CONFIG_HOME")) |value|
+        try alloc.dupeZ(u8, value)
+    else
+        null;
+    defer {
+        if (saved_xdg_config_home) |value| {
+            _ = env_os.setenv("XDG_CONFIG_HOME", value);
+            alloc.free(value);
+        } else {
+            _ = env_os.unsetenv("XDG_CONFIG_HOME");
+        }
+    }
+
+    _ = env_os.setenv("XDG_CONFIG_HOME", xdg_config_home);
+
+    const path = try defaultXdgPath(alloc);
+    defer alloc.free(path);
+    const expected = try std.fs.path.join(alloc, &.{ xdg_config_home, "astrohacker", "termsurf", "config" });
+    defer alloc.free(expected);
+    try std.testing.expectEqualStrings(expected, path);
+}
