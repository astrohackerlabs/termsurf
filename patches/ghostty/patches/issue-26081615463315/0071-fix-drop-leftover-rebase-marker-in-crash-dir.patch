From fa5addd04a0f76e226ed8bd70e18d73b1b8b9b1f Mon Sep 17 00:00:00 2001
From: "Ryan X. Charles" <ryan@ryanxcharles.com>
Date: Fri, 14 Aug 2026 06:48:31 -0500
Subject: [PATCH 71/75] fix: drop leftover rebase marker in crash dir

A stray closer from the termsurf path
broke Zig before the host could build.
---
 src/crash/dir.zig | 1 -
 1 file changed, 1 deletion(-)

diff --git a/src/crash/dir.zig b/src/crash/dir.zig
index b5c92e99a..652160076 100644
--- a/src/crash/dir.zig
+++ b/src/crash/dir.zig
@@ -6,7 +6,6 @@ const internal_os = @import("../os/main.zig");
 /// freed with the given allocator.
 pub fn defaultDir(io: std.Io, alloc: Allocator, environ_map: *const std.process.Environ.Map) !Dir {
     const crash_dir = try internal_os.xdg.state(io, alloc, environ_map, .{ .subdir = "astrohacker/termsurf/crash" });
->>>>>>> 874255e6f (Rename product XDG paths to astrohacker/termsurf)
     errdefer alloc.free(crash_dir);
     return .{ .path = crash_dir };
 }
