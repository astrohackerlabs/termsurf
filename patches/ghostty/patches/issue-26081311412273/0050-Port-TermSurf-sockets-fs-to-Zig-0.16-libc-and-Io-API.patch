From dc3df46d109c581af43a6ac69bc727361353731b Mon Sep 17 00:00:00 2001
From: "Ryan X. Charles" <ryan@ryanxcharles.com>
Date: Sun, 26 Jul 2026 13:55:16 -0500
Subject: [PATCH 50/75] Port TermSurf sockets/fs to Zig 0.16 libc and Io APIs

Replace removed std.posix socket wrappers and std.net Address with
cImport unix sockets; use Io.Dir for paths and IpAddress for probes.
---
 src/apprt/termsurf.zig | 144 ++++++++++++++++++++++++++++++-----------
 src/config/Config.zig  |   2 +-
 2 files changed, 106 insertions(+), 40 deletions(-)

diff --git a/src/apprt/termsurf.zig b/src/apprt/termsurf.zig
index 9ea32830a..62a57c2a8 100644
--- a/src/apprt/termsurf.zig
+++ b/src/apprt/termsurf.zig
@@ -3,10 +3,13 @@ const builtin = @import("builtin");
 const build_config = @import("../build_config.zig");
 const internal_os = @import("../os/main.zig");
 const global = @import("../global.zig");
+const fd_compat = @import("../lib/compat/fd.zig");
 
 const c = @cImport({
     @cInclude("stdlib.h");
     @cInclude("sys/socket.h");
+    @cInclude("sys/un.h");
+    @cInclude("sys/wait.h");
     @cInclude("unistd.h");
     @cInclude("termsurf.pb-c.h");
     @cInclude("termsurf_render_channel.h");
@@ -21,6 +24,72 @@ fn processGetenv(name: [*:0]const u8) ?[:0]const u8 {
 }
 
 
+fn pclose(fd: std.posix.fd_t) void {
+    fd_compat.close(fd);
+}
+
+fn punlink(path: [*:0]const u8) void {
+    _ = c.unlink(path);
+}
+
+fn psocket() !std.posix.fd_t {
+    const rc = c.socket(c.AF_UNIX, c.SOCK_STREAM, 0);
+    if (rc < 0) return error.SocketFailed;
+    return @intCast(rc);
+}
+
+fn pbindUnix(fd: std.posix.fd_t, path_z: [:0]const u8) !void {
+    var addr: c.struct_sockaddr_un = std.mem.zeroes(c.struct_sockaddr_un);
+    addr.sun_family = c.AF_UNIX;
+    if (path_z.len >= addr.sun_path.len) return error.NameTooLong;
+    @memcpy(addr.sun_path[0..path_z.len], path_z);
+    addr.sun_path[path_z.len] = 0;
+    const path_len = path_z.len + 1;
+    const addr_len: c.socklen_t = @intCast(@offsetOf(c.struct_sockaddr_un, "sun_path") + path_len);
+    if (c.bind(fd, @ptrCast(&addr), addr_len) != 0) return error.BindFailed;
+}
+
+fn plisten(fd: std.posix.fd_t, backlog: c_int) !void {
+    if (c.listen(fd, backlog) != 0) return error.ListenFailed;
+}
+
+fn paccept(fd: std.posix.fd_t) !std.posix.fd_t {
+    const rc = c.accept(fd, null, null);
+    if (rc < 0) return error.AcceptFailed;
+    return @intCast(rc);
+}
+
+fn pconnectUnix(fd: std.posix.fd_t, path_z: [:0]const u8) !void {
+    var addr: c.struct_sockaddr_un = std.mem.zeroes(c.struct_sockaddr_un);
+    addr.sun_family = c.AF_UNIX;
+    if (path_z.len >= addr.sun_path.len) return error.NameTooLong;
+    @memcpy(addr.sun_path[0..path_z.len], path_z);
+    addr.sun_path[path_z.len] = 0;
+    const path_len = path_z.len + 1;
+    const addr_len: c.socklen_t = @intCast(@offsetOf(c.struct_sockaddr_un, "sun_path") + path_len);
+    if (c.connect(fd, @ptrCast(&addr), addr_len) != 0) return error.ConnectFailed;
+}
+
+fn pshutdown(fd: std.posix.fd_t) void {
+    _ = c.shutdown(fd, c.SHUT_RDWR);
+}
+
+fn pwaitpidNoHang(pid: i32) i32 {
+    var status: c_int = 0;
+    const rc = c.waitpid(@intCast(pid), &status, c.WNOHANG);
+    return @intCast(rc);
+}
+
+fn pmakePath(path: []const u8) !void {
+    try std.Io.Dir.cwd().createDirPath(global.io(), path);
+}
+
+fn paccessAbsolute(path: []const u8) !void {
+    try std.Io.Dir.accessAbsolute(global.io(), path, .{});
+}
+
+
+
 const env_key: [:0]const u8 = "TERMSURF_SOCKET";
 const max_frame_size: usize = 1024 * 1024;
 const max_clients: usize = 128;
@@ -873,22 +942,21 @@ pub fn start() !void {
         "{s}{s}termsurf",
         .{ tmpdir, sep },
     ) catch return error.SocketPathTooLong;
-    try std.fs.cwd().makePath(dir_z);
+    try pmakePath(dir_z);
 
     const path_z = try socketPath(tmpdir, sep);
-    std.posix.unlink(path_z) catch {};
+    punlink(path_z);
     errdefer {
-        std.posix.unlink(path_z) catch {};
+        punlink(path_z);
         socket_path_len = 0;
         _ = internal_os.unsetenv(env_key);
     }
 
-    const fd = try std.posix.socket(std.posix.AF.UNIX, std.posix.SOCK.STREAM, 0);
-    errdefer std.posix.close(fd);
+    const fd = try psocket();
+    errdefer pclose(fd);
 
-    const addr = try std.net.Address.initUnix(path_z);
-    try std.posix.bind(fd, &addr.any, addr.getOsSockLen());
-    try std.posix.listen(fd, 8);
+    try pbindUnix(fd, path_z);
+    try plisten(fd, 8);
 
     if (internal_os.setenv(env_key, path_z) != 0) return error.SetEnvFailed;
 
@@ -913,7 +981,7 @@ pub fn stop() void {
     wakeAccept();
 
     if (fd >= 0) {
-        std.posix.close(fd);
+        pclose(fd);
     }
     if (thread) |t| {
         t.join();
@@ -924,8 +992,8 @@ pub fn stop() void {
         if (maybe_thread) |t| t.join();
     }
     if (socket_path_len > 0) {
-        const path = socket_path_buf[0..socket_path_len];
-        std.posix.unlink(path) catch {};
+        const path = socket_path_buf[0..socket_path_len :0];
+        punlink(path);
         socket_path_len = 0;
     }
 
@@ -934,14 +1002,14 @@ pub fn stop() void {
 
 fn acceptLoop(fd: std.posix.fd_t) void {
     while (!stopping.load(.acquire)) {
-        const client_fd = std.posix.accept(fd, null, null, 0) catch |err| {
+        const client_fd = paccept(fd) catch |err| {
             if (!stopping.load(.acquire)) {
                 log.warn("TermSurf socket accept failed err={}", .{err});
             }
             return;
         };
         if (stopping.load(.acquire)) {
-            std.posix.close(client_fd);
+            pclose(client_fd);
             return;
         }
         log.info("TermSurf client connected fd={}", .{client_fd});
@@ -949,14 +1017,14 @@ fn acceptLoop(fd: std.posix.fd_t) void {
         joinClientThreads(reapDoneClients());
         const slot_index = reserveClient(client_fd) orelse {
             log.warn("TermSurf client limit reached fd={}", .{client_fd});
-            std.posix.close(client_fd);
+            pclose(client_fd);
             continue;
         };
 
         const thread = std.Thread.spawn(.{}, handleClient, .{ client_fd, slot_index }) catch |err| {
             log.warn("TermSurf client thread failed fd={} err={}", .{ client_fd, err });
             clearClient(slot_index);
-            std.posix.close(client_fd);
+            pclose(client_fd);
             continue;
         };
 
@@ -975,7 +1043,7 @@ fn handleClient(fd: std.posix.fd_t, slot_index: usize) void {
         }
         if (conn_type == .browser) cleanupBrowserConnection(fd);
         markClientDone(slot_index);
-        std.posix.close(fd);
+        pclose(fd);
     }
 
     const allocator = std.heap.c_allocator;
@@ -1168,7 +1236,7 @@ fn stopClients() [max_clients]?std.Thread {
     clients_mutex.lockUncancelable(global.io());
     for (&clients, 0..) |*slot, i| {
         if (slot.fd >= 0) {
-            std.posix.shutdown(slot.fd, .both) catch {};
+            pshutdown(slot.fd);
             slot.fd = -1;
         }
         threads[i] = slot.thread;
@@ -3220,7 +3288,7 @@ fn shutdownBrowserSocket(snapshot: *const ServerShutdownSnapshot) void {
 fn reapServerChild(snapshot: *const ServerShutdownSnapshot) void {
     if (snapshot.child_pid == 0) return;
     for (0..50) |_| {
-        const res = std.posix.waitpid(snapshot.child_pid, std.c.W.NOHANG);
+        const res = pwaitpidNoHang(snapshot.child_pid);
         if (res.pid != 0) {
             log.info(
                 "Server child reaped: profile={s} browser={s} pid={}",
@@ -4665,7 +4733,7 @@ fn buildBrowserLogFile(buf: []u8) ?[:0]u8 {
         std.fmt.bufPrintZ(&dir_buf, "{s}/astrohacker/termsurf", .{base}) catch return null
     else
         std.fmt.bufPrintZ(&dir_buf, "{s}/.local/state/astrohacker/termsurf", .{home}) catch return null;
-    std.fs.cwd().makePath(dir) catch |err| {
+    pmakePath(dir) catch |err| {
         log.warn("browser log directory create failed path={s} err={}", .{ dir, err });
     };
     return std.fmt.bufPrintZ(buf, "{s}/chromium-server.log", .{dir}) catch null;
@@ -4810,11 +4878,10 @@ fn copyError(buf: *[256]u8, message: []const u8) bool {
 
 fn resolveFirstExistingPath(candidates: []const [:0]const u8, buf: []u8) ?[:0]u8 {
     for (candidates) |candidate| {
-        if (std.fs.cwd().realpathZ(candidate, buf)) |resolved| {
-            if (resolved.len >= buf.len) return null;
-            buf[resolved.len] = 0;
-            return buf[0..resolved.len :0];
-        } else |_| {}
+        const n = std.Io.Dir.cwd().realPathFile(global.io(), candidate, buf) catch continue;
+        if (n >= buf.len) return null;
+        buf[n] = 0;
+        return buf[0..n :0];
     }
     return null;
 }
@@ -4828,15 +4895,16 @@ fn chooseLocalPort() ?u16 {
 }
 
 fn canConnectLocalPort(port: u16) bool {
-    const stream = std.net.tcpConnectToHost(std.heap.c_allocator, "127.0.0.1", port) catch return false;
-    stream.close();
+    const addr: std.Io.net.IpAddress = .{ .ip4 = .loopback(port) };
+    var stream = addr.connect(global.io(), .{}) catch return false;
+    stream.close(global.io());
     return true;
 }
 
 fn setHealthProbeReadTimeout(fd: std.posix.socket_t) !void {
     var timeout = std.posix.timeval{
-        .sec = 0,
-        .usec = 250 * 1000,
+        .tv_sec = 0,
+        .tv_usec = 250 * 1000,
     };
     try std.posix.setsockopt(fd, std.posix.SOL.SOCKET, std.posix.SO.RCVTIMEO, std.mem.asBytes(&timeout));
 }
@@ -4988,12 +5056,11 @@ fn connTypeName(conn_type: ConnType) []const u8 {
 fn wakeAccept() void {
     if (socket_path_len == 0) return;
 
