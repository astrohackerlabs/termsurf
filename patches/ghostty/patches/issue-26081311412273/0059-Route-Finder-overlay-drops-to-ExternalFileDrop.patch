+    // Browser overlay: route OS/Finder file drops into Chromium (file transfer Exp 1).
+    // Page-initiated drag remains suppressed in the engine.
+    if termsurfOverlayFrame != nil,
+      let urls = pb.readObjects(forClasses: [NSURL.self]) as? [URL],
+      !urls.isEmpty
+    {
+      let filePaths = urls.filter { $0.isFileURL }.map { $0.path }
+      if !filePaths.isEmpty {
+        let viewPoint = convert(sender.draggingLocation, from: nil)
+        let topOriginPoint = CGPoint(x: viewPoint.x, y: bounds.height - viewPoint.y)
+        let overlayFrame = termsurfOverlayFrame!
+        let webPoint = CGPoint(
+          x: topOriginPoint.x - overlayFrame.minX,
+          y: topOriginPoint.y - overlayFrame.minY)
+        var cPaths: [UnsafeMutablePointer<CChar>?] = filePaths.map { strdup($0) }
+        defer {
+          for ptr in cPaths {
+            if let ptr { free(ptr) }
+          }
+        }
+        let ok = cPaths.withUnsafeMutableBufferPointer { ptrBuf -> Int32 in
+          let constBuf = UnsafeMutableRawPointer(ptrBuf.baseAddress)
+            .map { $0.assumingMemoryBound(to: UnsafePointer<CChar>?.self) }
+          return termsurf_external_file_drop(
+            self.id.uuidString,
+            constBuf,
+            ptrBuf.count,
+            Double(webPoint.x),
+            Double(webPoint.y))
+        }
+        if ok != 0 {
+          return true
+        }
+        // Fall through to terminal path insert if engine rejected.
+      }
+    }
