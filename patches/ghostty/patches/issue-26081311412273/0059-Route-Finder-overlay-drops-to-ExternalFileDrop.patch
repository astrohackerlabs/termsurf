+/// Finder/OS file drop onto browser overlay (Issue 26072811532404 Exp 1).
+pub fn externalFileDrop(
+    pane_id: []const u8,
+    paths: []const []const u8,
+    x: f64,
+    y: f64,
+) bool {
+    if (paths.len == 0) return false;
+    const snapshot = snapshotBrowserInput(pane_id, false) orelse {
+        log.warn("ExternalFileDrop: no browser snapshot pane_id={s}", .{pane_id});
+        return false;
+    };
+
+    const allocator = std.heap.c_allocator;
+    var owned_paths: [][:0]u8 = allocator.alloc([:0]u8, paths.len) catch return false;
+    defer {
+        for (owned_paths) |p| allocator.free(p);
+        allocator.free(owned_paths);
+    }
+    var path_c_ptrs: [][*]u8 = allocator.alloc([*]u8, paths.len) catch return false;
+    defer allocator.free(path_c_ptrs);
+
+    for (paths, 0..) |path, i| {
+        owned_paths[i] = allocator.dupeZ(u8, path) catch return false;
+        path_c_ptrs[i] = owned_paths[i].ptr;
+    }
+
+    var drop: c.Termsurf__ExternalFileDrop = undefined;
+    c.termsurf__external_file_drop__init(&drop);
+    drop.tab_id = snapshot.tab_id;
+    drop.n_paths = paths.len;
+    drop.paths = @ptrCast(path_c_ptrs.ptr);
+    drop.x = x;
+    drop.y = y;
+
+    var wrapper: c.Termsurf__TermSurfMessage = undefined;
+    c.termsurf__term_surf_message__init(&wrapper);
+    wrapper.msg_case = c.TERMSURF__TERM_SURF_MESSAGE__MSG_EXTERNAL_FILE_DROP;
+    wrapper.unnamed_0.external_file_drop = &drop;
+
+    sendProtobuf(snapshot.browser_fd, &wrapper) catch |err| {
+        log.warn(
+            "ExternalFileDrop send failed pane_id={s} tab_id={} err={}",
+            .{ snapshot.paneId(), snapshot.tab_id, err },
+        );
+        return false;
+    };
+    log.info(
+        "ExternalFileDrop: pane_id={s} tab_id={} paths={} x={d:.1} y={d:.1}",
+        .{ snapshot.paneId(), snapshot.tab_id, paths.len, x, y },
+    );
+    return true;
+}
