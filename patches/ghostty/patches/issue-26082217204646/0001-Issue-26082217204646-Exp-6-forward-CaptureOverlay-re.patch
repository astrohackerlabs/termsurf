+fn sendCaptureOverlayError(
+    tui_fd: std.posix.fd_t,
+    pane_id: []const u8,
+    request_id: u64,
+    error_text: []const u8,
+) void {
+    if (tui_fd < 0) return;
+    var pane_buf: [max_pane_id_len]u8 = undefined;
+    var pane_len: usize = 0;
+    if (!copyText(&pane_buf, &pane_len, pane_id)) return;
+    var err_buf: [128]u8 = undefined;
+    var err_len: usize = 0;
+    if (!copyText(&err_buf, &err_len, error_text)) return;
+
+    var reply: c.Termsurf__CaptureOverlayReply = undefined;
+    c.termsurf__capture_overlay_reply__init(&reply);
+    reply.pane_id = @constCast(pane_buf[0..pane_len :0].ptr);
+    reply.request_id = request_id;
+    reply.ok = 0;
+    reply.@"error" = @constCast(err_buf[0..err_len :0].ptr);
+
+    var wrapper: c.Termsurf__TermSurfMessage = undefined;
+    c.termsurf__term_surf_message__init(&wrapper);
+    wrapper.msg_case = c.TERMSURF__TERM_SURF_MESSAGE__MSG_CAPTURE_OVERLAY_REPLY;
+    wrapper.unnamed_0.capture_overlay_reply = &reply;
+    sendProtobuf(tui_fd, &wrapper) catch |err| {
+        log.warn(
+            "CaptureOverlayReply error send failed pane_id={s} request_id={} err={}",
+            .{ pane_id, request_id, err },
+        );
+    };
+}
+
+fn handleCaptureOverlayRequest(
+    tui_fd: std.posix.fd_t,
+    req: ?*c.Termsurf__CaptureOverlayRequest,
+) bool {
+    const capture_req = req orelse {
+        log.warn("CaptureOverlayRequest: missing payload", .{});
+        return false;
+    };
+    const pane_id = cString(capture_req.*.pane_id);
+    const request_id = capture_req.*.request_id;
+
+    var browser_fd: std.posix.fd_t = -1;
+    var owned = false;
+    state_mutex.lockUncancelable(global.io());
+    if (findPane(pane_id)) |pane_index| {
+        const pane = &panes[pane_index];
+        if (pane.tui_fd == tui_fd) {
+            if (findServer(pane.profileName(), pane.browserName())) |server_index| {
+                browser_fd = servers[server_index].attached_fd;
+                owned = browser_fd >= 0;
+            }
+        }
+    }
+    state_mutex.unlock(global.io());
+
+    if (!owned) {
+        log.warn(
+            "CaptureOverlayRequest: unknown or unowned pane_id={s} fd={}",
+            .{ pane_id, tui_fd },
+        );
+        sendCaptureOverlayError(tui_fd, pane_id, request_id, "unknown pane");
+        return false;
+    }
+
+    var wrapper: c.Termsurf__TermSurfMessage = undefined;
+    c.termsurf__term_surf_message__init(&wrapper);
+    wrapper.msg_case = c.TERMSURF__TERM_SURF_MESSAGE__MSG_CAPTURE_OVERLAY_REQUEST;
+    wrapper.unnamed_0.capture_overlay_request = capture_req;
+    sendProtobuf(browser_fd, &wrapper) catch |err| {
+        log.warn(
+            "CaptureOverlayRequest send failed pane_id={s} request_id={} err={}",
+            .{ pane_id, request_id, err },
+        );
+        sendCaptureOverlayError(tui_fd, pane_id, request_id, "engine send failed");
+        return false;
+    };
+    log.info(
+        "CaptureOverlayRequest: pane_id={s} request_id={}",
+        .{ pane_id, request_id },
+    );
+    return true;
+}
+
+fn handleCaptureOverlayReply(
+    browser_fd: std.posix.fd_t,
+    req: ?*c.Termsurf__CaptureOverlayReply,
+) bool {
+    const reply = req orelse {
+        log.warn("CaptureOverlayReply: missing payload", .{});
+        return false;
+    };
+    const pane_id = cString(reply.*.pane_id);
+
+    var tui_fd: std.posix.fd_t = -1;
+    state_mutex.lockUncancelable(global.io());
+    const server_index = findServerByFd(browser_fd);
+    if (server_index) |idx| {
+        if (findPane(pane_id)) |pane_index| {
+            const pane = &panes[pane_index];
+            if (std.mem.eql(u8, pane.profileName(), servers[idx].profileName()) and
+                std.mem.eql(u8, pane.browserName(), servers[idx].browserName()))
+            {
+                tui_fd = pane.tui_fd;
+            }
+        }
+    }
+    state_mutex.unlock(global.io());
+    if (tui_fd < 0) {
+        log.warn(
+            "CaptureOverlayReply: no TUI for pane_id={s} request_id={}",
+            .{ pane_id, reply.*.request_id },
+        );
+        return false;
+    }
+
+    var wrapper: c.Termsurf__TermSurfMessage = undefined;
+    c.termsurf__term_surf_message__init(&wrapper);
+    wrapper.msg_case = c.TERMSURF__TERM_SURF_MESSAGE__MSG_CAPTURE_OVERLAY_REPLY;
+    wrapper.unnamed_0.capture_overlay_reply = reply;
+    sendProtobuf(tui_fd, &wrapper) catch |err| {
+        log.warn(
+            "CaptureOverlayReply send failed pane_id={s} request_id={} err={}",
+            .{ pane_id, reply.*.request_id, err },
+        );
+        return false;
+    };
+    log.info(
+        "CaptureOverlayReply: pane_id={s} request_id={} ok={} png_len={}",
+        .{ pane_id, reply.*.request_id, reply.*.ok, reply.*.png.len },
+    );
+    return true;
+}
