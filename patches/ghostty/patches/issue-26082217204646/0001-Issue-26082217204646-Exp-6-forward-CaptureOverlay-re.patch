+test "termsurf overlay capture forwards TUI request and engine PNG reply" {
+    const testing = std.testing;
+
+    resetTermsurfStateForTest();
+    defer resetTermsurfStateForTest();
+    try testing.expect(max_frame_size >= 16 * 1024 * 1024);
+
+    var browser_a = try testSocketPair();
+    defer testCloseSocketPair(&browser_a);
+    var browser_b = try testSocketPair();
+    defer testCloseSocketPair(&browser_b);
+    var tui_a = try testSocketPair();
+    defer testCloseSocketPair(&tui_a);
+    var tui_b = try testSocketPair();
+    defer testCloseSocketPair(&tui_b);
+
+    try testSetPendingServer(0, "default", "chromium");
+    servers[0].attached_fd = browser_a[0];
+    try testSetPendingServer(1, "default", "webkit");
+    servers[1].attached_fd = browser_b[0];
+    try testSetPane(0, "pane-a", "default", "chromium", "https://a.test/", tui_a[0]);
+    try testSetPane(1, "pane-b", "default", "webkit", "https://b.test/", tui_b[0]);
+    panes[0].tab_id = 77;
+    panes[1].tab_id = 88;
+
+    var req: c.Termsurf__CaptureOverlayRequest = undefined;
+    c.termsurf__capture_overlay_request__init(&req);
+    req.pane_id = @constCast("pane-a");
+    req.request_id = 9;
+    try testing.expect(handleCaptureOverlayRequest(tui_a[0], &req));
+
+    const forwarded = try readTestMessage(browser_a[1], testing.allocator);
+    defer c.termsurf__term_surf_message__free_unpacked(forwarded, null);
+    try testing.expectEqual(
+        @as(c.Termsurf__TermSurfMessage__MsgCase, c.TERMSURF__TERM_SURF_MESSAGE__MSG_CAPTURE_OVERLAY_REQUEST),
+        forwarded.*.msg_case,
+    );
+    try testing.expectEqualStrings("pane-a", cString(forwarded.*.unnamed_0.capture_overlay_request.*.pane_id));
+    try testing.expectEqual(@as(u64, 9), forwarded.*.unnamed_0.capture_overlay_request.*.request_id);
+
+    var png = [_]u8{ 0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a };
+    var reply: c.Termsurf__CaptureOverlayReply = undefined;
+    c.termsurf__capture_overlay_reply__init(&reply);
+    reply.pane_id = @constCast("pane-a");
+    reply.request_id = 9;
+    reply.ok = 1;
+    reply.png.data = &png;
+    reply.png.len = png.len;
+    reply.width_px = 32;
+    reply.height_px = 16;
+    try testing.expect(handleCaptureOverlayReply(browser_a[0], &reply));
+
+    const to_tui = try readTestMessage(tui_a[1], testing.allocator);
+    defer c.termsurf__term_surf_message__free_unpacked(to_tui, null);
+    try testing.expectEqual(
+        @as(c.Termsurf__TermSurfMessage__MsgCase, c.TERMSURF__TERM_SURF_MESSAGE__MSG_CAPTURE_OVERLAY_REPLY),
+        to_tui.*.msg_case,
+    );
+    const got = to_tui.*.unnamed_0.capture_overlay_reply;
+    try testing.expectEqualStrings("pane-a", cString(got.*.pane_id));
+    try testing.expectEqual(@as(u64, 9), got.*.request_id);
+    try testing.expectEqual(@as(c_int, 1), got.*.ok);
+    try testing.expectEqual(@as(usize, png.len), got.*.png.len);
+    try testing.expectEqualSlices(u8, png[0..], got.*.png.data[0..got.*.png.len]);
+    try testing.expectEqual(@as(u64, 32), got.*.width_px);
+    try testing.expectEqual(@as(u64, 16), got.*.height_px);
+
+    try testing.expect(!handleCaptureOverlayRequest(tui_b[0], &req));
+    const denied = try readTestMessage(tui_b[1], testing.allocator);
+    defer c.termsurf__term_surf_message__free_unpacked(denied, null);
+    try testing.expectEqual(
+        @as(c.Termsurf__TermSurfMessage__MsgCase, c.TERMSURF__TERM_SURF_MESSAGE__MSG_CAPTURE_OVERLAY_REPLY),
+        denied.*.msg_case,
+    );
+    try testing.expectEqual(@as(c_int, 0), denied.*.unnamed_0.capture_overlay_reply.*.ok);
+
+    var missing: c.Termsurf__CaptureOverlayRequest = undefined;
+    c.termsurf__capture_overlay_request__init(&missing);
+    missing.pane_id = @constCast("missing-pane");
+    missing.request_id = 4;
+    try testing.expect(!handleCaptureOverlayRequest(tui_a[0], &missing));
+    const missing_reply = try readTestMessage(tui_a[1], testing.allocator);
+    defer c.termsurf__term_surf_message__free_unpacked(missing_reply, null);
+    try testing.expectEqual(
+        @as(c.Termsurf__TermSurfMessage__MsgCase, c.TERMSURF__TERM_SURF_MESSAGE__MSG_CAPTURE_OVERLAY_REPLY),
+        missing_reply.*.msg_case,
+    );
+    try testing.expectEqual(@as(c_int, 0), missing_reply.*.unnamed_0.capture_overlay_reply.*.ok);
+    try testing.expectEqual(@as(u64, 4), missing_reply.*.unnamed_0.capture_overlay_reply.*.request_id);
+}
