+/*
+ * Chromium download lifecycle → pane progress bar (Issue 26073112048720 Exp 3).
+ * total_bytes == 0 means unknown size → indeterminate surface progress.
+ */
+struct  Termsurf__DownloadProgress
+{
+  ProtobufCMessage base;
+  int64_t tab_id;
+  /*
+   * "active", "done", "error", "cancelled"
+   */
+  char *state;
+  uint64_t received_bytes;
+  /*
+   * 0 = unknown
+   */
+  uint64_t total_bytes;
+};
