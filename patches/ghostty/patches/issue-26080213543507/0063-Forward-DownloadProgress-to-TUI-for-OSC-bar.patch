+}
+size_t termsurf__download_progress__pack
+                     (const Termsurf__DownloadProgress *message,
+                      uint8_t       *out)
+{
+  assert(message->base.descriptor == &termsurf__download_progress__descriptor);
+  return protobuf_c_message_pack ((const ProtobufCMessage*)message, out);
+}
+size_t termsurf__download_progress__pack_to_buffer
+                     (const Termsurf__DownloadProgress *message,
+                      ProtobufCBuffer *buffer)
+{
+  assert(message->base.descriptor == &termsurf__download_progress__descriptor);
+  return protobuf_c_message_pack_to_buffer ((const ProtobufCMessage*)message, buffer);
+}
+Termsurf__DownloadProgress *
+       termsurf__download_progress__unpack
+                     (ProtobufCAllocator  *allocator,
+                      size_t               len,
+                      const uint8_t       *data)
+{
+  return (Termsurf__DownloadProgress *)
+     protobuf_c_message_unpack (&termsurf__download_progress__descriptor,
+                                allocator, len, data);
+}
+void   termsurf__download_progress__free_unpacked
+                     (Termsurf__DownloadProgress *message,
+                      ProtobufCAllocator *allocator)
+{
+  if(!message)
+    return;
+  assert(message->base.descriptor == &termsurf__download_progress__descriptor);
+  protobuf_c_message_free_unpacked ((ProtobufCMessage*)message, allocator);
+}
