+/// Forward engine download progress to the bound TUI (ahweb emits OSC progress).
+fn handleDownloadProgress(
+    browser_fd: std.posix.fd_t,
+    req: ?*c.Termsurf__DownloadProgress,
+) bool {
+    const progress = req orelse return false;
+    if (progress.*.tab_id <= 0) return false;
+
+    state_mutex.lockUncancelable(global.io());
+    const server_index = findServerByFd(browser_fd) orelse {
+        state_mutex.unlock(global.io());
+        return false;
+    };
+    const server = &servers[server_index];
+    const lookup_index = findTabLookup(
+        server.profileName(),
+        server.browserName(),
+        progress.*.tab_id,
+    ) orelse {
+        state_mutex.unlock(global.io());
+        return false;
+    };
+    const pane_index = findPane(tab_lookups[lookup_index].paneId()) orelse {
+        state_mutex.unlock(global.io());
+        return false;
+    };
+    const tui_fd = panes[pane_index].tui_fd;
+    const exact_identity = panes[pane_index].tab_id == progress.*.tab_id;
+    state_mutex.unlock(global.io());
+    if (!exact_identity or tui_fd < 0) return false;
+
+    var wrapper: c.Termsurf__TermSurfMessage = undefined;
+    c.termsurf__term_surf_message__init(&wrapper);
+    wrapper.msg_case = c.TERMSURF__TERM_SURF_MESSAGE__MSG_DOWNLOAD_PROGRESS;
+    wrapper.unnamed_0.download_progress = progress;
+    sendProtobuf(tui_fd, &wrapper) catch return false;
+    return true;
+}
+
