@@ -5298,20 +5326,31 @@ fn sendFileChooserReply(
 }
 
 /// Called from AppKit after NSOpenPanel completes (Swift @_cdecl bridge).
+/// pane_id resolves the browser_fd so multi-engine same tab/request cannot collide.
 pub fn fileChooserComplete(
+    pane_id: []const u8,
     tab_id: i64,
     request_id: u64,
     accepted: bool,
     paths: []const []const u8,
 ) void {
     state_mutex.lockUncancelable(global.io());
-    const pending = takePendingFileChooser(tab_id, request_id);
+    var browser_fd: std.posix.fd_t = -1;
+    if (findPane(pane_id)) |pane_index| {
+        const profile = panes[pane_index].profileName();
+        const browser = panes[pane_index].browserName();
+        if (findServer(profile, browser)) |server_index| {
+            browser_fd = servers[server_index].attached_fd;
+        }
+    }
+    // Fall back: match tab+request alone only when browser_fd unknown (single-engine).
+    const pending = takePendingFileChooser(tab_id, request_id, browser_fd);
     state_mutex.unlock(global.io());
 
     const slot = pending orelse {
         log.warn(
-            "FileChooserComplete: no pending tab_id={} request_id={}",
-            .{ tab_id, request_id },
+            "FileChooserComplete: no pending tab_id={} request_id={} pane_id={s}",
+            .{ tab_id, request_id, pane_id },
         );
         return;
     };
