+/// Pending chooser identity is (browser_fd, tab_id, request_id). Never replace
+/// browser_fd across different engines with the same tab/request counters
+/// (Issue 26073012571498 Exp 1 multi-engine isolation).
 fn reservePendingFileChooser(tab_id: i64, request_id: u64, browser_fd: std.posix.fd_t) bool {
-    // Replace an existing slot for the same tab/request if present.
     for (&pending_file_choosers) |*slot| {
-        if (slot.in_use and slot.tab_id == tab_id and slot.request_id == request_id) {
-            slot.browser_fd = browser_fd;
+        if (slot.in_use and slot.browser_fd == browser_fd and slot.tab_id == tab_id and
+            slot.request_id == request_id)
+        {
+            // Same connection re-request: keep the slot.
             return true;
         }
     }
@@ -5160,11 +5175,13 @@ fn reservePendingFileChooser(tab_id: i64, request_id: u64, browser_fd: std.posix
     return false;
 }
 
-fn takePendingFileChooser(tab_id: i64, request_id: u64) ?PendingFileChooser {
+fn takePendingFileChooser(tab_id: i64, request_id: u64, browser_fd: std.posix.fd_t) ?PendingFileChooser {
     for (&pending_file_choosers) |*slot| {
         if (!slot.in_use) continue;
         if (slot.tab_id != tab_id) continue;
         if (request_id != 0 and slot.request_id != request_id) continue;
+        // Prefer exact browser_fd match; browser_fd < 0 means first match (legacy tests).
+        if (browser_fd >= 0 and slot.browser_fd != browser_fd) continue;
         const copy = slot.*;
         slot.* = .{};
         return copy;
@@ -5172,6 +5189,17 @@ fn takePendingFileChooser(tab_id: i64, request_id: u64) ?PendingFileChooser {
     return null;
 }
 
+fn clearPendingFileChoosersForBrowserFd(browser_fd: std.posix.fd_t) usize {
+    var cleared: usize = 0;
+    for (&pending_file_choosers) |*slot| {
+        if (!slot.in_use) continue;
+        if (slot.browser_fd != browser_fd) continue;
+        slot.* = .{};
+        cleared += 1;
+    }
+    return cleared;
+}
