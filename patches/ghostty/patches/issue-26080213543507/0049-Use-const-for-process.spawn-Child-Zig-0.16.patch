From a3d31c268dc436ddf386e7feb8f27697bc2a8215 Mon Sep 17 00:00:00 2001
From: "Ryan X. Charles" <ryan@ryanxcharles.com>
Date: Sun, 26 Jul 2026 13:52:35 -0500
Subject: [PATCH 49/65] Use const for process.spawn Child (Zig 0.16)

---
 src/apprt/termsurf.zig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/apprt/termsurf.zig b/src/apprt/termsurf.zig
index d6a5b30a4..9ea32830a 100644
--- a/src/apprt/termsurf.zig
+++ b/src/apprt/termsurf.zig
@@ -4476,7 +4476,7 @@ fn spawnBrowserProcess(
     // Historical WebKit (Surfari) DYLD_FRAMEWORK_PATH injection removed with
     // the shipped WebKit product engine. Absolute-path helpers must set their
     // own runtime env if needed.
-    var child = std.process.spawn(global.io(), .{
+    const child = std.process.spawn(global.io(), .{
         .argv = argv,
         .stdin = .ignore,
         .stdout = .inherit,
