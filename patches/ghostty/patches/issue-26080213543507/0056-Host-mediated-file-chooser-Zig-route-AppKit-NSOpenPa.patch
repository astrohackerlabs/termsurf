+const max_pending_file_choosers: usize = 8;
+
+const PendingFileChooser = struct {
+    in_use: bool = false,
+    tab_id: i64 = 0,
+    request_id: u64 = 0,
+    browser_fd: std.posix.fd_t = -1,
+};
+
+var pending_file_choosers: [max_pending_file_choosers]PendingFileChooser =
+    [_]PendingFileChooser{.{}} ** max_pending_file_choosers;
+
 const ClientSlot = struct {
     fd: std.posix.fd_t = -1,
     thread: ?std.Thread = null,
@@ -1211,6 +1245,9 @@ fn handleClient(fd: std.posix.fd_t, slot_index: usize) void {
                 c.TERMSURF__TERM_SURF_MESSAGE__MSG_OPEN_SPLIT => {
                     handleOpenSplit(msg.*.unnamed_0.open_split);
                 },
+                c.TERMSURF__TERM_SURF_MESSAGE__MSG_FILE_CHOOSER_REQUEST => {
+                    handleFileChooserRequest(fd, msg.*.unnamed_0.file_chooser_request);
+                },
                 else => {
                     log.info("TermSurf message ignored type={s}", .{msgTypeName(msg.*.msg_case)});
                 },
@@ -5092,10 +5129,204 @@ fn msgTypeName(msg_case: c.Termsurf__TermSurfMessage__MsgCase) []const u8 {
         c.TERMSURF__TERM_SURF_MESSAGE__MSG_HTTP_AUTH_REQUEST => "HttpAuthRequest",
         c.TERMSURF__TERM_SURF_MESSAGE__MSG_HTTP_AUTH_REPLY => "HttpAuthReply",
         c.TERMSURF__TERM_SURF_MESSAGE__MSG_RENDERER_CRASHED => "RendererCrashed",
+        c.TERMSURF__TERM_SURF_MESSAGE__MSG_FILE_CHOOSER_REQUEST => "FileChooserRequest",
+        c.TERMSURF__TERM_SURF_MESSAGE__MSG_FILE_CHOOSER_REPLY => "FileChooserReply",
         else => "Other",
     };
 }
 
+fn reservePendingFileChooser(tab_id: i64, request_id: u64, browser_fd: std.posix.fd_t) bool {
+    // Replace an existing slot for the same tab/request if present.
+    for (&pending_file_choosers) |*slot| {
+        if (slot.in_use and slot.tab_id == tab_id and slot.request_id == request_id) {
+            slot.browser_fd = browser_fd;
+            return true;
+        }
+    }
+    for (&pending_file_choosers) |*slot| {
+        if (!slot.in_use) {
+            slot.* = .{
+                .in_use = true,
+                .tab_id = tab_id,
+                .request_id = request_id,
+                .browser_fd = browser_fd,
+            };
+            return true;
+        }
+    }
+    return false;
+}
+
+fn takePendingFileChooser(tab_id: i64, request_id: u64) ?PendingFileChooser {
+    for (&pending_file_choosers) |*slot| {
+        if (!slot.in_use) continue;
+        if (slot.tab_id != tab_id) continue;
+        if (request_id != 0 and slot.request_id != request_id) continue;
+        const copy = slot.*;
+        slot.* = .{};
+        return copy;
+    }
+    return null;
+}
+
+fn handleFileChooserRequest(fd: std.posix.fd_t, req: ?*c.Termsurf__FileChooserRequest) void {
+    const chooser = req orelse {
+        log.warn("FileChooserRequest: missing payload", .{});
+        return;
+    };
+    const tab_id = chooser.*.tab_id;
+    const request_id = chooser.*.request_id;
+    const mode_z: [:0]const u8 = if (chooser.*.mode) |m| std.mem.span(m) else "open";
+    const origin_z: [:0]const u8 = if (chooser.*.origin_url) |o| std.mem.span(o) else "";
+
+    var pane_id_buf: [max_pane_id_len]u8 = undefined;
+    var pane_id_len: usize = 0;
+    var found_pane = false;
+    var reserved = false;
+    var should_cancel = false;
+
+    {
+        state_mutex.lockUncancelable(global.io());
+        defer state_mutex.unlock(global.io());
+
+        if (findServerByFd(fd)) |server_index| {
+            const profile = servers[server_index].profileName();
+            const browser = servers[server_index].browserName();
+            if (findTabLookup(profile, browser, tab_id)) |lookup_index| {
+                const pane_id = tab_lookups[lookup_index].paneId();
+                if (copyText(&pane_id_buf, &pane_id_len, pane_id)) {
+                    found_pane = true;
+                }
+            }
+        }
+
+        if (!found_pane) {
+            // Fall back: match any pane with this tab_id.
+            for (&panes) |*pane| {
+                if (!pane.in_use) continue;
+                if (pane.tab_id != tab_id) continue;
+                if (copyText(&pane_id_buf, &pane_id_len, pane.paneId())) {
+                    found_pane = true;
+                    break;
+                }
+            }
+        }
+
+        if (!reservePendingFileChooser(tab_id, request_id, fd)) {
+            log.warn(
+                "FileChooserRequest: no pending slot tab_id={} request_id={}",
+                .{ tab_id, request_id },
+            );
+            should_cancel = true;
+        } else if (!found_pane) {
+            log.warn(
+                "FileChooserRequest: unknown pane tab_id={} request_id={} — cancel",
+                .{ tab_id, request_id },
+            );
+            _ = takePendingFileChooser(tab_id, request_id);
+            should_cancel = true;
+        } else {
+            reserved = true;
+        }
+    }
+
+    if (should_cancel) {
+        sendFileChooserReply(fd, tab_id, request_id, false, &.{}) catch {};
+        return;
+    }
+    if (!reserved) return;
+
+    log.info(
+        "FileChooserRequest: tab_id={} request_id={} mode={s} pane_id={s}",
+        .{ tab_id, request_id, mode_z, pane_id_buf[0..pane_id_len] },
+    );
+
+    termsurf_request_file_chooser(
+        pane_id_buf[0..pane_id_len :0].ptr,
+        tab_id,
+        request_id,
+        mode_z.ptr,
+        origin_z.ptr,
+    );
+}
+
+fn sendFileChooserReply(
+    browser_fd: std.posix.fd_t,
+    tab_id: i64,
+    request_id: u64,
+    accepted: bool,
+    paths: []const []const u8,
+) !void {
+    var reply: c.Termsurf__FileChooserReply = undefined;
+    c.termsurf__file_chooser_reply__init(&reply);
+    reply.tab_id = tab_id;
+    reply.request_id = request_id;
+    reply.accepted = if (accepted) 1 else 0;
+
+    const allocator = std.heap.c_allocator;
+    var owned_paths: [][:0]u8 = &.{};
+    var path_c_ptrs: [][*]u8 = &.{};
+    defer {
+        for (owned_paths) |p| allocator.free(p);
+        if (owned_paths.len > 0) allocator.free(owned_paths);
+        if (path_c_ptrs.len > 0) allocator.free(path_c_ptrs);
+    }
+
+    if (accepted and paths.len > 0) {
+        owned_paths = try allocator.alloc([:0]u8, paths.len);
+        path_c_ptrs = try allocator.alloc([*]u8, paths.len);
+        for (paths, 0..) |path, i| {
+            owned_paths[i] = try allocator.dupeZ(u8, path);
+            path_c_ptrs[i] = owned_paths[i].ptr;
+        }
+        reply.n_paths = paths.len;
+        reply.paths = @ptrCast(path_c_ptrs.ptr);
+    }
+
+    var wrapper: c.Termsurf__TermSurfMessage = undefined;
+    c.termsurf__term_surf_message__init(&wrapper);
+    wrapper.msg_case = c.TERMSURF__TERM_SURF_MESSAGE__MSG_FILE_CHOOSER_REPLY;
+    wrapper.unnamed_0.file_chooser_reply = &reply;
+    try sendProtobuf(browser_fd, &wrapper);
+    log.info(
+        "FileChooserReply: tab_id={} request_id={} accepted={} paths={}",
+        .{ tab_id, request_id, accepted, paths.len },
+    );
+}
+
+/// Called from AppKit after NSOpenPanel completes (Swift @_cdecl bridge).
+pub fn fileChooserComplete(
+    tab_id: i64,
+    request_id: u64,
+    accepted: bool,
+    paths: []const []const u8,
+) void {
+    state_mutex.lockUncancelable(global.io());
+    const pending = takePendingFileChooser(tab_id, request_id);
+    state_mutex.unlock(global.io());
+
+    const slot = pending orelse {
+        log.warn(
+            "FileChooserComplete: no pending tab_id={} request_id={}",
+            .{ tab_id, request_id },
+        );
+        return;
+    };
+    if (slot.browser_fd < 0) {
+        log.warn(
+            "FileChooserComplete: invalid browser fd tab_id={} request_id={}",
+            .{ tab_id, request_id },
+        );
+        return;
+    }
+    sendFileChooserReply(slot.browser_fd, tab_id, request_id, accepted, paths) catch |err| {
+        log.warn(
+            "FileChooserComplete: send failed tab_id={} request_id={} err={}",
+            .{ tab_id, request_id, err },
+        );
+    };
+}
