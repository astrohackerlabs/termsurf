+/// AppKit NSOpenPanel completion → FileChooserReply on the engine connection.
+pub export fn termsurf_file_chooser_complete(
+    tab_id: i64,
+    request_id: u64,
+    accepted: c_int,
+    paths: ?[*]?[*:0]const u8,
+    path_count: usize,
+) void {
+    var path_slices: [64][]const u8 = undefined;
+    const n = @min(path_count, path_slices.len);
+    if (accepted != 0 and paths != null and n > 0) {
+        const path_array = paths.?;
+        var i: usize = 0;
+        while (i < n) : (i += 1) {
+            if (path_array[i]) |p| {
+                path_slices[i] = std.mem.span(p);
+            } else {
+                path_slices[i] = "";
+            }
+        }
+        termsurf.fileChooserComplete(tab_id, request_id, true, path_slices[0..n]);
+    } else {
+        termsurf.fileChooserComplete(tab_id, request_id, false, &.{});
+    }
+}
