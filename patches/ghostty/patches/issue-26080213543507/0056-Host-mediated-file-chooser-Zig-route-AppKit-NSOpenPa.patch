 }
 
+private func termsurfLogFileChooser(_ message: String) {
+  AppDelegate.logger.info("\(message)")
+  fputs("\(message)\n", stderr)
+}
+
+/// Zig → AppKit: present NSOpenPanel as the main TermSurf app (not ah-chromiumd).
+@_cdecl("termsurf_request_file_chooser")
+func termsurf_request_file_chooser(
+  _ paneIDPointer: UnsafePointer<CChar>?,
+  _ tabID: Int64,
+  _ requestID: UInt64,
+  _ modePointer: UnsafePointer<CChar>?,
+  _ originURLPointer: UnsafePointer<CChar>?
+) {
+  guard let paneIDPointer else {
+    termsurfLogFileChooser("TermSurf file chooser rejected: missing pane id")
+    termsurf_file_chooser_complete(tabID, requestID, 0, nil, 0)
+    return
+  }
+
+  let paneID = String(cString: paneIDPointer)
+  let mode = modePointer.map { String(cString: $0) } ?? "open"
+  let originURL = originURLPointer.map { String(cString: $0) } ?? ""
+  let allowsMultiple = mode == "open_multiple"
+
+  termsurfLogFileChooser(
+    "TermSurf file chooser request pane_id=\(paneID) tab_id=\(tabID) request_id=\(requestID) mode=\(mode) origin=\(originURL)"
+  )
+
+  DispatchQueue.main.async {
+    guard let appDelegate = NSApplication.shared.delegate as? AppDelegate else {
+      termsurfLogFileChooser("TermSurf file chooser rejected: missing app delegate")
+      termsurf_file_chooser_complete(tabID, requestID, 0, nil, 0)
+      return
+    }
+    guard let uuid = UUID(uuidString: paneID) else {
+      termsurfLogFileChooser("TermSurf file chooser rejected: invalid pane id \(paneID)")
+      termsurf_file_chooser_complete(tabID, requestID, 0, nil, 0)
+      return
+    }
+    guard let target = appDelegate.findSurface(forUUID: uuid) else {
+      termsurfLogFileChooser("TermSurf file chooser rejected: no surface for pane id \(paneID)")
+      termsurf_file_chooser_complete(tabID, requestID, 0, nil, 0)
+      return
+    }
+
+    let panel = NSOpenPanel()
+    panel.canChooseFiles = true
+    panel.canChooseDirectories = false
+    panel.allowsMultipleSelection = allowsMultiple
+    panel.resolvesAliases = true
+    panel.title = "Choose File"
+    panel.prompt = "Select"
+    if !originURL.isEmpty {
+      panel.message = "Upload from \(originURL)"
+    }
+
+    let complete: (NSApplication.ModalResponse) -> Void = { response in
+      if response == .OK {
+        let urls = panel.urls
+        termsurfLogFileChooser(
+          "TermSurf file chooser accepted tab_id=\(tabID) request_id=\(requestID) count=\(urls.count)"
+        )
+        var cPaths: [UnsafeMutablePointer<CChar>?] = urls.map { pathURL in
+          strdup(pathURL.path)
+        }
+        defer {
+          for ptr in cPaths {
+            if let ptr { free(ptr) }
+          }
+        }
+        cPaths.withUnsafeMutableBufferPointer { ptrBuf in
+          // Zig export expects const char**; pass pointer array.
+          let constBuf = UnsafeMutableRawPointer(ptrBuf.baseAddress)
+            .map { $0.assumingMemoryBound(to: UnsafePointer<CChar>?.self) }
+          termsurf_file_chooser_complete(
+            tabID,
+            requestID,
+            1,
+            constBuf,
+            ptrBuf.count
+          )
+        }
+      } else {
+        termsurfLogFileChooser(
+          "TermSurf file chooser cancelled tab_id=\(tabID) request_id=\(requestID)"
+        )
+        termsurf_file_chooser_complete(tabID, requestID, 0, nil, 0)
+      }
+    }
+
+    if let window = target.window {
+      panel.beginSheetModal(for: window, completionHandler: complete)
+    } else {
+      complete(panel.runModal())
+    }
+  }
+}
