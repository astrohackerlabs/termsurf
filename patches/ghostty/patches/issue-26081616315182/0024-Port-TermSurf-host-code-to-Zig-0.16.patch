+/// Zig 0.16: processGetenv was removed; use libc getenv.
+fn processGetenv(name: [*:0]const u8) ?[:0]const u8 {
+    const v = std.posix.system.getenv(name) orelse return null;
+    return std.mem.span(v);
+}
+
+
+fn pclose(fd: std.posix.fd_t) void {
+    fd_compat.close(fd);
+}
+
+fn punlink(path: [*:0]const u8) void {
+    _ = c.unlink(path);
+}
+
+fn psocket() !std.posix.fd_t {
+    const rc = c.socket(c.AF_UNIX, c.SOCK_STREAM, 0);
+    if (rc < 0) return error.SocketFailed;
+    return @intCast(rc);
+}
+
+fn fillUnixAddr(path_z: [:0]const u8, addr: *c.struct_sockaddr_un) !c.socklen_t {
+    addr.* = std.mem.zeroes(c.struct_sockaddr_un);
+    addr.sun_family = c.AF_UNIX;
+    if (path_z.len >= addr.sun_path.len) return error.NameTooLong;
+    @memcpy(addr.sun_path[0..path_z.len], path_z);
+    addr.sun_path[path_z.len] = 0;
+    const path_len = path_z.len + 1;
+    const addr_len: c.socklen_t = @intCast(@offsetOf(c.struct_sockaddr_un, "sun_path") + path_len);
+    // BSD/Darwin sockaddr_un includes sun_len; Zig Address.initUnix set this.
+    if (comptime builtin.os.tag.isDarwin()) {
+        addr.sun_len = @intCast(addr_len);
+    }
+    return addr_len;
+}
+
+fn pbindUnix(fd: std.posix.fd_t, path_z: [:0]const u8) !void {
+    var addr: c.struct_sockaddr_un = undefined;
+    const addr_len = try fillUnixAddr(path_z, &addr);
+    if (c.bind(fd, @ptrCast(&addr), addr_len) != 0) return error.BindFailed;
+}
+
+fn plisten(fd: std.posix.fd_t, backlog: c_int) !void {
+    if (c.listen(fd, backlog) != 0) return error.ListenFailed;
+}
+
+fn paccept(fd: std.posix.fd_t) !std.posix.fd_t {
+    while (true) {
+        const rc = c.accept(fd, null, null);
+        if (rc >= 0) return @intCast(rc);
+        switch (std.posix.errno(rc)) {
+            .INTR => continue,
+            else => return error.AcceptFailed,
+        }
+    }
+}
+
+fn pconnectUnix(fd: std.posix.fd_t, path_z: [:0]const u8) !void {
+    var addr: c.struct_sockaddr_un = undefined;
+    const addr_len = try fillUnixAddr(path_z, &addr);
+    while (true) {
+        const rc = c.connect(fd, @ptrCast(&addr), addr_len);
+        if (rc == 0) return;
+        switch (std.posix.errno(rc)) {
+            .INTR => continue,
+            else => return error.ConnectFailed,
+        }
+    }
+}
+
+fn pshutdown(fd: std.posix.fd_t) void {
+    _ = c.shutdown(fd, c.SHUT_RDWR);
+}
+
+fn pwaitpidNoHang(pid: i32) i32 {
+    var status: c_int = 0;
+    const rc = c.waitpid(@intCast(pid), &status, c.WNOHANG);
+    return @intCast(rc);
+}
+
+fn pmakePath(path: []const u8) !void {
+    try std.Io.Dir.cwd().createDirPath(global.io(), path);
+}
+
+fn paccessAbsolute(path: []const u8) !void {
+    try std.Io.Dir.accessAbsolute(global.io(), path, .{});
+}
+
+
+
 const env_key: [:0]const u8 = "TERMSURF_SOCKET";
+
+/// Socket path while IPC is configured (set by socketPath during start).
+pub fn listeningSocketPath() ?[:0]const u8 {
+    if (socket_path_len == 0) return null;
+    return socket_path_buf[0..socket_path_len :0];
+}
+
+/// Inject TERMSURF_SOCKET into a termio/surface env map.
+/// Prefer module path (authoritative after start); fall back to live getenv.
+/// This is the Zig 0.16-safe product path: do not rely on cached global.environ
+/// alone after libc setenv.
+pub fn ensureSocketInEnv(env: *std.process.Environ.Map) !void {
+    if (listeningSocketPath()) |path| {
+        try env.put(env_key, path);
+        return;
+    }
+    if (processGetenv(env_key)) |v| {
+        try env.put(env_key, v);
+    }
+}
+
+/// Test helper: set listening path state without binding a real socket.
+pub fn testingSetListeningSocketPath(path: []const u8) !void {
+    if (path.len == 0 or path.len >= socket_path_buf.len) return error.NameTooLong;
+    @memcpy(socket_path_buf[0..path.len], path);
+    socket_path_buf[path.len] = 0;
+    socket_path_len = path.len;
+}
+
+pub fn testingClearListeningSocketPath() void {
+    socket_path_len = 0;
+}
