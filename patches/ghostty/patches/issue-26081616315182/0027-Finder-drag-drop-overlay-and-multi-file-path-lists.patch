+/// Finder/OS file drag phase onto browser overlay → ExternalFileDrop on engine.
+/// phase: "enter"|"over"|"leave"|"drop" (NULL => "drop").
+pub export fn termsurf_external_file_drop(
+    pane_id: [*:0]const u8,
+    paths: ?[*]?[*:0]const u8,
+    path_count: usize,
+    x: f64,
+    y: f64,
+    phase: ?[*:0]const u8,
+) c_int {
+    const phase_slice: []const u8 = if (phase) |p| std.mem.span(p) else "drop";
+    if (path_count > max_host_file_paths) {
+        std.log.warn(
+            "termsurf_external_file_drop: path_count={} exceeds max {}; rejecting",
+            .{ path_count, max_host_file_paths },
+        );
+        return 0;
     }
+    const path_slices = collectCPathSlices(paths, path_count) orelse {
+        if (path_count > 0) {
+            std.log.warn(
+                "termsurf_external_file_drop: alloc failed path_count={}; rejecting",
+                .{path_count},
+            );
+            return 0;
+        }
+        return if (termsurf.externalFileDrop(
+            std.mem.span(pane_id),
+            &.{},
+            x,
+            y,
+            phase_slice,
+        ))
+            1
+        else
+            0;
+    };
+    defer if (path_slices.len > 0) std.heap.c_allocator.free(path_slices);
+    return if (termsurf.externalFileDrop(
+        std.mem.span(pane_id),
+        path_slices,
+        x,
+        y,
+        phase_slice,
+    ))
+        1
+    else
+        0;
 }
 
