-        var i: usize = 0;
-        while (i < n) : (i += 1) {
-            if (path_array[i]) |p| {
-                path_slices[i] = std.mem.span(p);
-            } else {
-                path_slices[i] = "";
-            }
+    const pane_slice: []const u8 = if (pane_id) |p| std.mem.span(p) else "";
+    if (accepted != 0 and paths != null and path_count > 0) {
+        if (path_count > max_host_file_paths) {
+            std.log.warn(
+                "termsurf_file_chooser_complete: path_count={} exceeds max {}; cancelling",
+                .{ path_count, max_host_file_paths },
+            );
+            termsurf.fileChooserComplete(pane_slice, tab_id, request_id, false, &.{});
+            return;
         }
-        termsurf.fileChooserComplete(tab_id, request_id, true, path_slices[0..n]);
+        const path_slices = collectCPathSlices(paths, path_count) orelse {
+            std.log.warn(
+                "termsurf_file_chooser_complete: alloc failed path_count={}; cancelling",
+                .{path_count},
+            );
+            termsurf.fileChooserComplete(pane_slice, tab_id, request_id, false, &.{});
+            return;
+        };
+        defer if (path_slices.len > 0) std.heap.c_allocator.free(path_slices);
+        termsurf.fileChooserComplete(pane_slice, tab_id, request_id, true, path_slices);
     } else {
-        termsurf.fileChooserComplete(tab_id, request_id, false, &.{});
