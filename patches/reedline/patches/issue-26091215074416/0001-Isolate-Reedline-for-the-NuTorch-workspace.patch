From a4e8953b8dca874b12fcb323bbd90a6958e5f6b1 Mon Sep 17 00:00:00 2001
From: "Ryan X. Charles" <ryan@ryanxcharles.com>
Date: Sat, 12 Sep 2026 14:04:15 -0500
Subject: [PATCH] Isolate Reedline for the NuTorch workspace

A workspace fence around the plot
Keeps parent Cargo out of the lot.
---
 AGENTS.md  | 2 +-
 Cargo.toml | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/AGENTS.md b/AGENTS.md
index 7f09ac6..5aaa587 100644
--- a/AGENTS.md
+++ b/AGENTS.md
@@ -1,6 +1,6 @@
 # AGENTS.md — Reedline checkout
 
-Ignored Reedline checkout used by `ahsh`. Read `patches/AGENTS.md`,
+Ignored Reedline checkout used by `nutorch`. Read `patches/AGENTS.md`,
 `patches/reedline/AGENTS.md`, and its reconstruction README before work.
 
 The default is a zero-patch tip pin. Any intentional source edit requires an
diff --git a/Cargo.toml b/Cargo.toml
index 1816b42..6861f58 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,3 +1,5 @@
+[workspace]
+
 [package]
 authors = ["The Nushell Project Developers"]
 description = "A readline-like crate for CLI text input"
-- 
2.50.1 (Apple Git-155)

